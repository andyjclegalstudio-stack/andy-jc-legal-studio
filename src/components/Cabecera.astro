---
import Marca from './Marca.astro';
import { wa, MENSAJE_GENERAL } from '../lib/whatsapp';
import site from '../data/site.json';

const rutaActual = Astro.url.pathname.replace(/\/$/, '') || '/';
const enlaces = [
  { href: '/servicios', texto: 'Servicios' },
  { href: '/planes', texto: 'Planes' },
  { href: '/academy', texto: 'Academy' },
  { href: '/referidos', texto: 'Referidos' },
  { href: '/contacto', texto: 'Contacto' },
];
const activo = (href: string) => rutaActual === href || rutaActual.startsWith(href + '/');
---
<header class="border-b border-linea bg-white">
  <div class="contenedor flex items-center justify-between gap-6 py-4">
    <a href="/" class="flex items-center gap-3 no-underline" aria-label={`${site.nombre} — inicio`}>
      <Marca tamano="cabecera" />
    </a>

    <nav aria-label="Navegación principal" class="hidden md:block">
      <ul class="m-0 flex list-none items-center gap-8 p-0">
        {enlaces.map((e) => (
          <li>
            <a
              href={e.href}
              aria-current={activo(e.href) ? 'page' : undefined}
              class:list={[
                'text-base no-underline transition-colors hover:text-jade',
                activo(e.href) ? 'text-jade' : 'text-tinta',
              ]}
            >
              {e.texto}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <a
      href={wa(MENSAJE_GENERAL)}
      target="_blank"
      rel="noopener noreferrer"
      class="hidden md:inline-flex items-center gap-2 rounded-none bg-jade px-5 py-2.5 text-base font-semibold text-white no-underline transition-colors hover:bg-tinta"
    >
      <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.9 9.9 0 0 0 4.79 1.22h.01c5.46 0 9.9-4.45 9.9-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2Zm0 18.15h-.01a8.2 8.2 0 0 1-4.19-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.2 8.2 0 0 1-1.26-4.38c0-4.54 3.7-8.23 8.25-8.23 2.2 0 4.27.86 5.83 2.41a8.19 8.19 0 0 1 2.41 5.83c0 4.54-3.7 8.23-8.24 8.23Zm4.52-6.16c-.25-.13-1.47-.72-1.69-.81-.23-.08-.39-.12-.56.13-.16.24-.64.8-.78.97-.15.16-.29.19-.53.06-.25-.12-1.05-.38-1.99-1.23-.74-.65-1.23-1.46-1.38-1.71-.14-.25-.01-.38.11-.5.11-.11.25-.29.37-.44.13-.15.17-.25.25-.41.09-.17.04-.31-.02-.44-.06-.12-.56-1.35-.77-1.84-.2-.49-.4-.42-.55-.43h-.48c-.16 0-.43.06-.65.31-.22.25-.85.83-.85 2.03s.87 2.35.99 2.51c.12.16 1.71 2.61 4.14 3.66.58.25 1.03.4 1.38.51.58.19 1.11.16 1.53.1.47-.07 1.47-.6 1.67-1.18.21-.58.21-1.07.15-1.18-.06-.11-.22-.17-.47-.29Z"/>
      </svg>
      WhatsApp
    </a>
  </div>

  <!-- Navegación móvil: fila propia, sin menú desplegable ni JavaScript. -->
  <nav aria-label="Navegación principal" class="md:hidden border-t border-linea">
    <ul class="contenedor m-0 flex list-none items-center gap-5 overflow-x-auto py-4 text-meta">
      {enlaces.map((e) => (
        <li class="shrink-0">
          <a
            href={e.href}
            aria-current={activo(e.href) ? 'page' : undefined}
            class:list={['no-underline', activo(e.href) ? 'text-jade' : 'text-tinta']}
          >
            {e.texto}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>
