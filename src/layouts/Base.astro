---
import '../styles/global.css';
import Cabecera from '../components/Cabecera.astro';
import Pie from '../components/Pie.astro';
import WhatsAppFijo from '../components/WhatsAppFijo.astro';
import site from '../data/site.json';
import { MENSAJE_GENERAL } from '../lib/whatsapp';

interface Props {
  titulo: string;
  descripcion: string;
  mensajeFijo?: string;
  /* La página de la reunión (/diagnostico) trae su propia barra inferior. */
  sinBarra?: boolean;
  jsonLd?: unknown;
}
const { titulo, descripcion, mensajeFijo = MENSAJE_GENERAL, sinBarra = false, jsonLd } = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const og = new URL('/og-image.png', Astro.site).href;

/* En todas las páginas: quién está detrás del sitio y cuándo se publicó esta
   versión. La fecha es la del build, que Vercel vuelve a correr en cada cambio. */
const publicado = new Date().toISOString().slice(0, 10);
const jsonLdSitio = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'LegalService',
      '@id': `${Astro.site}#estudio`,
      name: site.nombre,
      url: Astro.site?.href,
      logo: new URL('/favicon-512.png', Astro.site).href,
      email: site.correo,
      telephone: `+${site.whatsapp}`,
      address: { '@type': 'PostalAddress', addressLocality: 'Huánuco', addressCountry: 'PE' },
      description: site.descripcion,
      knowsAbout: ['Derecho Empresarial', 'Derecho Digital', 'Protección de datos personales', 'Contratos', 'Marcas', 'Cumplimiento'],
    },
    {
      '@type': 'WebPage',
      '@id': canonical,
      url: canonical,
      name: titulo,
      description: descripcion,
      inLanguage: 'es-PE',
      isPartOf: { '@type': 'WebSite', name: site.nombre, url: Astro.site?.href },
      author: { '@id': `${Astro.site}#estudio` },
      publisher: { '@id': `${Astro.site}#estudio` },
      dateModified: publicado,
    },
  ],
};
---
<!doctype html>
<html lang="es-PE">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
    <meta name="description" content={descripcion} />
    <meta name="author" content={site.nombre} />
    <meta property="article:modified_time" content={publicado} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="512x512" href="/favicon-512.png" />
    <link rel="apple-touch-icon" href="/favicon-180.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#16283A" />
    {/* Antes de pintar: si la persona eligió un modo, se aplica sin destello. */}
    <script is:inline>
      try { var t = localStorage.getItem('tema'); if (t === 'dark' || t === 'light') document.documentElement.dataset.theme = t; } catch (e) {}
    </script>

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_PE" />
    <meta property="og:site_name" content={site.nombre} />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={titulo} />
    <meta name="twitter:description" content={descripcion} />
    <meta name="twitter:image" content={og} />

    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLdSitio)} />
    {jsonLd && (
      <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
    )}
  </head>
  <body class:list={[sinBarra ? '' : 'pb-[88px] md:pb-0']}>
    <a
      href="#contenido"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-full focus:bg-tinta focus:px-4 focus:py-2 focus:text-white"
    >
      Saltar al contenido
    </a>
    <Cabecera />
    <main id="contenido">
      <slot />
    </main>
    <Pie />
    {!sinBarra && <WhatsAppFijo mensaje={mensajeFijo} />}
  </body>
</html>
