---
interface Props {
  etiqueta?: string;
  titulo: string;
  entrada?: string;
  sobreTinta?: boolean;
  class?: string;
}
const { etiqueta, titulo, entrada, sobreTinta = false, class: clase = '' } = Astro.props;
---
<div class:list={['flex flex-col gap-3.5', clase]}>
  {etiqueta && (
    <p class:list={['m-0 etiqueta', sobreTinta ? 'text-claro' : 'text-gris']}>{etiqueta}</p>
  )}
  <h2 class:list={['m-0 text-seccion', sobreTinta ? 'text-white' : 'text-tinta']}>{titulo}</h2>
  {entrada && (
    <p class:list={['m-0 max-w-[600px] text-lead', sobreTinta ? 'text-claro' : 'text-tenue']}>{entrada}</p>
  )}
</div>
