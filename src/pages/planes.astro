---
import Base from '../layouts/Base.astro';
import TarjetaPlan from '../components/TarjetaPlan.astro';
import Boton from '../components/Boton.astro';
import BotonWhatsApp from '../components/BotonWhatsApp.astro';
import Faq from '../components/Faq.astro';
import planes from '../data/planes.json';
import catalogo from '../data/catalogo.json';
import kit from '../data/kit.json';
import site from '../data/site.json';
import { soles, conPrecio } from '../lib/planes';
import { wa } from '../lib/whatsapp';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'OfferCatalog',
  name: 'Planes mensuales de asesoría legal',
  provider: { '@type': 'LegalService', name: site.nombre, url: Astro.site?.href },
  itemListElement: [
    ...conPrecio.map((p) => ({
      '@type': 'Offer',
      name: `Plan ${p.nombre}`,
      description: p.para,
      price: String(p.precio),
      priceCurrency: 'PEN',
      category: 'Asesoría legal por suscripción mensual',
      eligibleCustomerType: 'Business',
      url: new URL('/planes/', Astro.site).href,
    })),
    {
      '@type': 'Offer',
      name: kit.nombre,
      description: kit.bajada,
      price: String(kit.precio),
      priceCurrency: 'PEN',
      category: 'Encargo de pago único',
      eligibleCustomerType: 'Business',
      url: new URL('/planes/#kit', Astro.site).href,
    },
  ],
};

const chip = (activo: boolean) =>
  `min-h-11 cursor-pointer rounded-full border px-4.5 font-sans text-[14px] font-semibold transition-colors ${
    activo ? 'border-tinta bg-tinta text-white' : 'border-linea-fuerte bg-white text-tinta hover:bg-niebla'
  }`;
---

<Base
  titulo="Planes mensuales de área legal externa para empresas | Díada"
  descripcion="Arranque, Operación y Cumplimiento: un equipo de abogados especialistas como área legal externa de tu empresa, por una cuota mensual sin permanencia, o el kit de despegue de pago único."
  mensajeFijo="Hola, vengo de la web. Quiero información sobre los planes mensuales."
  jsonLd={jsonLd}
>
  {/* Portada */}
  <section class="px-6 pb-14 pt-[clamp(40px,6vw,80px)] text-center">
    <div class="mx-auto flex max-w-[980px] flex-col items-center gap-6">
      <p class="m-0 etiqueta text-gris">Planes para empresas</p>
      <h1 class="m-0 text-[clamp(42px,6vw,88px)] leading-[1.02] tracking-[-0.025em] text-tinta">
        Un área legal completa,<br />por una <span class="italic">cuota mensual.</span>
      </h1>
      <p class="m-0 max-w-[620px] text-lead text-tenue">
        Sin permanencia, con un equipo de especialistas y una base legal armada para tu rubro, o el kit de despegue si prefieres empezar sin cuota.
      </p>

      <div
        role="group"
        aria-label="Periodo de facturación"
        class="mt-2 inline-flex gap-1 rounded-full bg-niebla p-1.5"
        data-facturacion
      >
        <button type="button" aria-pressed="true" data-periodo="mensual" class="min-h-11 cursor-pointer rounded-full border-0 bg-tinta px-5.5 font-sans text-[15px] font-semibold text-white aria-[pressed=false]:bg-transparent aria-[pressed=false]:text-tinta">
          Mensual
        </button>
        <button type="button" aria-pressed="false" data-periodo="anual" class="min-h-11 cursor-pointer rounded-full border-0 bg-tinta px-5.5 font-sans text-[15px] font-semibold text-white aria-[pressed=false]:bg-transparent aria-[pressed=false]:text-tinta">
          Anual · 2 meses de ahorro
        </button>
      </div>
    </div>
  </section>

  {/* Por qué un área legal externa */}
  <section class="px-6 pb-14" aria-labelledby="t-comparacion">
    <div class="mx-auto flex max-w-[1240px] flex-col gap-6">
      <h2 id="t-comparacion" class="m-0 etiqueta text-gris">{planes.comparacion.titulo}</h2>
      <div class="grid gap-4 md:grid-cols-3">
        {planes.comparacion.opciones.map((o) => (
          <div class:list={['flex flex-col gap-3 rounded-[18px] border p-6', o.conviene ? 'border-tinta bg-tinta text-white sobre-tinta' : 'border-linea bg-white']}>
            <strong class="font-display text-[22px] font-medium">{o.nombre}</strong>
            <ul class="m-0 flex list-none flex-col gap-2 p-0 text-[15px]">
              {o.puntos.map((pt) => (
                <li class:list={['flex gap-2.5', o.conviene ? 'text-claro' : 'text-tenue']}>
                  <span aria-hidden="true" class:list={['mt-2 h-1.5 w-1.5 shrink-0 rounded-full', o.conviene ? 'bg-acento' : 'bg-linea-fuerte']}></span>
                  {pt}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* Lo que incluyen los tres planes */}
  <section class="px-6 pb-10" aria-labelledby="t-base">
    <div class="mx-auto flex max-w-[1240px] flex-wrap items-start gap-x-12 gap-y-5 rounded-[18px] bg-niebla p-7 md:p-8">
      <div class="flex min-w-0 flex-[1_1_320px] flex-col gap-2">
        <h2 id="t-base" class="m-0 font-display text-[26px] font-medium">{planes.base.titulo}</h2>
        <p class="m-0 text-base text-tenue">{planes.base.texto}</p>
      </div>
      <ul class="m-0 flex min-w-0 flex-[1_1_440px] list-none flex-col gap-2.5 p-0 text-[15px]">
        {planes.base.items.map((it) => (
          <li class="flex gap-2.5">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="mt-0.5 shrink-0" aria-hidden="true"><path d="M5 12l5 5L20 7" /></svg>
            {it}
          </li>
        ))}
      </ul>
    </div>
  </section>

  {/* Los tres planes */}
  <section class="px-6 pb-[clamp(72px,9vw,112px)]" aria-labelledby="t-planes">
    <h2 id="t-planes" class="sr-only">Los tres planes</h2>
    <div class="mx-auto flex max-w-[1240px] flex-wrap items-stretch gap-5">
      {planes.planes.map((p) => (
        <div id={p.id} class="flex min-w-0 flex-[1_1_320px] scroll-mt-24">
          <TarjetaPlan plan={p} />
        </div>
      ))}
    </div>
    <p class="mx-auto mt-8 max-w-[1240px] text-center text-base">
      <a href="/portal" class="font-semibold underline decoration-tinta/35 underline-offset-4 hover:decoration-tinta">Mira cómo se ve tu empresa en el portal del cliente</a>
    </p>
    <ul class="mx-auto mt-5 flex max-w-[1240px] list-none flex-wrap justify-center gap-x-7 gap-y-2.5 p-0 text-[14px] text-tenue">
      {planes.notas.map((n, i) => (
        <li class="flex gap-7">
          {i > 0 && <span aria-hidden="true">·</span>}
          {n}
        </li>
      ))}
    </ul>
  </section>

  {/* Producto de entrada */}
  <section class="px-6 pb-[clamp(72px,9vw,112px)]" aria-labelledby="t-kit" id="kit">
    <div class="sobre-tinta mx-auto flex max-w-[1240px] flex-col gap-10 rounded-[24px] bg-tinta p-[clamp(32px,5vw,64px)] text-white">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <div class="flex max-w-[640px] flex-col gap-3.5">
          <p class="m-0 etiqueta text-claro">Pago único · sin cuota mensual</p>
          <h2 id="t-kit" class="m-0 text-seccion text-white">{kit.nombre} en {kit.plazo}.</h2>
          <p class="m-0 text-lead text-claro">{kit.bajada}</p>
        </div>
        <div class="flex flex-col items-start gap-1">
          <span class="text-[14px] text-claro">Pago único</span>
          <span class="text-[48px] font-semibold tracking-[-0.03em] tabular-nums leading-none">{soles(kit.precio)}</span>
        </div>
      </div>

      <ol class="m-0 flex list-none flex-wrap gap-8 p-0">
        {kit.pasos.map((paso) => (
          <li class="flex min-w-0 flex-[1_1_280px] flex-col gap-2.5 border-t border-linea-oscura pt-5">
            <span class="font-mono text-[12px] uppercase tracking-[0.12em] text-claro">{paso.dias}</span>
            <strong class="font-display text-[26px] font-medium leading-[1.15]">{paso.titulo}</strong>
            <span class="text-[15px] leading-[1.6] text-claro">{paso.texto}</span>
          </li>
        ))}
      </ol>

      <div class="flex flex-wrap items-center justify-between gap-6 border-t border-linea-oscura pt-7">
        <ul class="m-0 flex list-none flex-wrap gap-x-6 gap-y-2 p-0 text-[14px] text-claro">
          {kit.incluye.map((x) => <li class="flex items-center gap-2"><span aria-hidden="true" class="h-1.5 w-1.5 rounded-full bg-acento"></span>{x}</li>)}
        </ul>
        <BotonWhatsApp
          mensaje={`Hola, vengo de la web. Me interesa el ${kit.nombre} de pago único.`}
          etiqueta={`Pedir el ${kit.nombre.toLowerCase()}`}
          variante="acento"
          class="px-7"
        />
      </div>
    </div>
  </section>

  {/* Catálogo por documento */}
  <section class="bg-niebla px-6 py-[clamp(72px,9vw,112px)]" aria-labelledby="t-catalogo" data-catalogo>
    <div class="mx-auto flex max-w-[1240px] flex-col gap-9">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <div class="flex max-w-[640px] flex-col gap-3.5">
          <p class="m-0 etiqueta text-gris">Sin suscripción</p>
          <h2 id="t-catalogo" class="m-0 text-seccion text-tinta">Precio fijo por documento.</h2>
        </div>
        <p class="m-0 max-w-[380px] text-base text-tenue">{catalogo.descuento}</p>
      </div>

      <div role="group" aria-label="Filtrar por categoría" class="flex flex-wrap gap-2">
        <button type="button" aria-pressed="true" data-filtro="" class={chip(true)}>Todos</button>
        {catalogo.categorias.map((c) => (
          <button type="button" aria-pressed="false" data-filtro={c} class={chip(false)}>{c}</button>
        ))}
      </div>

      <div class="overflow-hidden rounded-[18px] border border-linea bg-white">
        {catalogo.documentos.map((d) => (
          <div
            data-categoria={d.categoria}
            class="flex flex-wrap items-center gap-x-8 gap-y-3 border-b border-linea px-7 py-5.5 last:border-b-0"
          >
            <span class="flex min-w-0 flex-[1_1_320px] flex-col gap-1">
              <strong class="text-[17px] font-semibold">{d.nombre}</strong>
              <span class="text-[14px] text-gris">{d.categoria}</span>
            </span>
            <span class="flex-[0_0_180px] text-[14px] text-tenue">{d.plazo}</span>
            <span class="flex-[0_0_130px] text-lead font-semibold">
              {d.precio ? soles(d.precio) : <span class="text-[15px] font-medium text-tenue">Consultar</span>}
            </span>
            <a
              href={wa(`Hola, vengo de la web. Quiero pedir este documento del catálogo: ${d.nombre}.`)}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex min-h-11 items-center rounded-full border-[1.5px] border-tinta px-4.5 text-[14px] font-semibold no-underline hover:bg-niebla"
            >
              Pedir
            </a>
          </div>
        ))}
        <p class="m-0 hidden px-7 py-8 text-base text-tenue" data-vacio>No hay documentos en esta categoría.</p>
      </div>
    </div>
  </section>

  {/* Comparativa */}
  <section class="px-6 py-[clamp(72px,9vw,112px)]" aria-labelledby="t-comparar">
    <div class="mx-auto flex max-w-[1240px] flex-col gap-7">
      <h2 id="t-comparar" class="m-0 text-[clamp(32px,3.6vw,48px)] leading-[1.08] text-tinta">Compara los planes</h2>
      <div class="overflow-x-auto border-t border-tinta">
        <table class="w-full min-w-[720px] border-collapse text-left text-[15px]">
          <caption class="sr-only">Comparación de lo que incluye cada plan mensual</caption>
          <thead>
            <tr>
              <th scope="col" class="py-4.5 pr-4 font-medium text-gris">Qué recibes</th>
              {planes.planes.map((p) => (
                <th scope="col" class="px-4 py-4.5 font-display text-[22px] font-medium">{p.nombre}</th>
              ))}
            </tr>
          </thead>
          <tbody>
            {planes.comparativa.map((f, i) => (
              <tr class:list={['border-t border-linea', i === planes.comparativa.length - 1 ? 'border-b' : '']}>
                <th scope="row" class="py-4 pr-4 font-medium">{f.fila}</th>
                {f.valores.map((v) => (
                  <td class:list={['px-4 py-4', v === 'No incluye' ? 'text-gris' : '']}>{v}</td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  {/* Sobre los planes */}
  <section class="bg-niebla px-6 py-[clamp(72px,9vw,112px)]" aria-labelledby="t-faq-planes">
    <div class="mx-auto flex max-w-[860px] flex-col gap-7">
      <h2 id="t-faq-planes" class="m-0 text-[clamp(32px,3.6vw,48px)] leading-[1.08] text-tinta">Sobre los planes</h2>
      <Faq items={planes.faq} />
    </div>
  </section>

  {/* Cierre */}
  <section id="contacto" class="px-6 py-[clamp(80px,10vw,136px)] text-center">
    <div class="mx-auto flex max-w-[900px] flex-col items-center gap-6">
      <h2 class="m-0 text-[clamp(38px,5vw,68px)] leading-[1.04] tracking-[-0.025em] text-tinta">
        ¿No sabes qué plan te conviene?
      </h2>
      <p class="m-0 text-lead text-tenue">
        En una reunión gratuita de 30 minutos te lo decimos, aunque la respuesta sea ninguno.
      </p>
      <Boton href="/diagnostico" class="px-7">Agendar reunión</Boton>
    </div>
  </section>
</Base>

<script>
  /* Mensual o anual: cambia el precio y la nota de cada tarjeta. */
  const grupo = document.querySelector<HTMLElement>('[data-facturacion]');
  if (grupo) {
    const botones = Array.from(grupo.querySelectorAll<HTMLButtonElement>('[data-periodo]'));
    botones.forEach((b) =>
      b.addEventListener('click', () => {
        const periodo = b.dataset.periodo as 'mensual' | 'anual';
        botones.forEach((o) => o.setAttribute('aria-pressed', o === b ? 'true' : 'false'));
        document.querySelectorAll<HTMLElement>('[data-plan] [data-precio], [data-plan] [data-nota]').forEach((el) => {
          el.textContent = el.dataset[periodo] ?? el.textContent;
        });
      })
    );
  }

  /* Filtro del catálogo por categoría. Sin JavaScript se ven todos. */
  const catalogo = document.querySelector<HTMLElement>('[data-catalogo]');
  if (catalogo) {
    const filtros = Array.from(catalogo.querySelectorAll<HTMLButtonElement>('[data-filtro]'));
    const filas = Array.from(catalogo.querySelectorAll<HTMLElement>('[data-categoria]'));
    const vacio = catalogo.querySelector<HTMLElement>('[data-vacio]');
    const activo = 'border-tinta bg-tinta text-white';
    const inactivo = 'border-linea-fuerte bg-white text-tinta hover:bg-niebla';
    filtros.forEach((f) =>
      f.addEventListener('click', () => {
        const cat = f.dataset.filtro ?? '';
        filtros.forEach((o) => {
          const es = o === f;
          o.setAttribute('aria-pressed', es ? 'true' : 'false');
          o.classList.remove(...activo.split(' '), ...inactivo.split(' '));
          o.classList.add(...(es ? activo : inactivo).split(' '));
        });
        let visibles = 0;
        filas.forEach((r) => {
          const ver = !cat || r.dataset.categoria === cat;
          r.hidden = !ver;
          if (ver) visibles++;
        });
        vacio?.classList.toggle('hidden', visibles > 0);
      })
    );
  }
</script>
