---
import { wa } from '../lib/whatsapp';
import { soles, precioAnual, MENSAJE_PLAN, type Plan } from '../lib/planes';

interface Props { plan: Plan }
const { plan: p } = Astro.props;

const anual = precioAnual(p);
const oscuro = p.destacado;

/* El interruptor mensual/anual de /planes lee estos atributos y cambia el texto. */
const notaAnual = p.desde ? p.nota : `${soles(anual.total)} facturados al año`;
---
<article
  data-plan
  class:list={[
    'flex min-w-0 flex-[1_1_320px] flex-col gap-6 rounded-tarjeta border px-8 py-9',
    oscuro ? 'sobre-tinta border-tinta bg-tinta text-white' : 'border-borde bg-white text-tinta',
  ]}
>
  <div class="flex min-h-7 items-center justify-between gap-3">
    <h3 class="m-0 font-display text-[32px] font-medium">{p.nombre}</h3>
    {p.destacado && (
      <span class="rounded-full bg-acento px-2.5 py-1.5 text-[11px] font-bold uppercase tracking-[0.08em] text-tinta">
        Recomendado
      </span>
    )}
  </div>

  <p class:list={['m-0 min-h-[46px] text-[15px] leading-[1.55]', oscuro ? 'text-claro' : 'text-tenue']}>
    {p.para}
  </p>

  <div class="flex flex-col gap-1">
    <span class="flex items-baseline gap-1.5">
      {p.desde && <span class:list={['text-[15px]', oscuro ? 'text-claro' : 'text-tenue']}>desde</span>}
      <span
        class="whitespace-nowrap text-[40px] font-semibold tracking-[-0.03em] tabular-nums md:text-[48px]"
        data-precio
        data-mensual={soles(p.precio)}
        data-anual={soles(anual.mensual)}
      >
        {soles(p.precio)}
      </span>
      <span class:list={['text-[15px]', oscuro ? 'text-claro' : 'text-tenue']}>/ mes</span>
    </span>
    <span
      class:list={['text-meta', oscuro ? 'text-claro' : 'text-tenue']}
      data-nota
      data-mensual={p.nota}
      data-anual={notaAnual}
    >
      {p.nota}
    </span>
  </div>

  <a
    href={wa(MENSAJE_PLAN(p.nombre))}
    target="_blank"
    rel="noopener noreferrer"
    class:list={[
      'flex min-h-[50px] items-center justify-center rounded-full border-[1.5px] font-bold no-underline transition-colors',
      oscuro
        ? 'border-acento bg-acento text-tinta hover:bg-white hover:border-white'
        : 'border-tinta bg-white text-tinta hover:bg-niebla',
    ]}
  >
    {p.cta}
  </a>

  <ul
    class:list={[
      'm-0 flex list-none flex-col gap-3 border-t p-0 pt-5.5 text-[15px] leading-[1.45]',
      oscuro ? 'border-linea-oscura' : 'border-linea',
    ]}
  >
    {p.incluye.map((linea) => (
      <li class="flex gap-2.5">
        <svg
          width="18" height="18" viewBox="0 0 24 24" fill="none"
          stroke={oscuro ? 'var(--color-acento)' : 'var(--color-tinta)'}
          stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"
          class="mt-0.5 shrink-0" aria-hidden="true"
        >
          <path d="M5 12l5 5L20 7" />
        </svg>
        <span>{linea}</span>
      </li>
    ))}
  </ul>
</article>
