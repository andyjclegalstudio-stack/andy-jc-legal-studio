---
import site from '../data/site.json';
import Marca from './Marca.astro';
import { wa, MENSAJE_GENERAL } from '../lib/whatsapp';
const anio = new Date().getFullYear();

const estudio = [
  { href: '/', texto: 'Inicio' },
  { href: '/servicios', texto: 'Servicios' },
  { href: '/planes', texto: 'Planes' },
  { href: '/academy', texto: 'Academy' },
  { href: '/#nosotros', texto: 'Nosotros' },
  { href: '/referidos', texto: 'Referidos' },
  { href: '/portal', texto: 'Portal del cliente (demo)' },
];
---
<footer class="border-t border-linea px-6 py-12">
  <div class="mx-auto flex max-w-[1240px] flex-wrap justify-between gap-8">
    <div class="flex min-w-0 flex-[1_1_320px] flex-col gap-3.5">
      <Marca tamano="pie" />
      <p class="m-0 max-w-[420px] text-meta text-gris">
        El contenido de este sitio es informativo y no constituye asesoría legal ni crea una
        relación abogado y cliente.
      </p>
    </div>

    <div class="flex flex-wrap gap-12 text-[14px]">
      <div class="flex flex-col gap-2.5">
        <strong class="font-semibold">Estudio</strong>
        {estudio.map((e) => (
          <a href={e.href} class="no-underline hover:underline">{e.texto}</a>
        ))}
      </div>
      <address class="flex flex-col gap-2.5 not-italic">
        <strong class="font-semibold">Contacto</strong>
        <a href={wa(MENSAJE_GENERAL)} target="_blank" rel="noopener noreferrer" class="no-underline hover:underline">
          WhatsApp {site.whatsappVisible}
        </a>
        <a href={`mailto:${site.correo}`} class="break-all no-underline hover:underline">{site.correo}</a>
        {site.redes.map((r: { nombre: string; url: string }) => (
          <a href={r.url} target="_blank" rel="noopener noreferrer" class="no-underline hover:underline">{r.nombre}</a>
        ))}
        <a href="/contacto" class="no-underline hover:underline">Contacto</a>
        <a href="/aviso-legal" class="no-underline hover:underline">Aviso legal</a>
      </address>
    </div>
  </div>

  <div class="mx-auto mt-8 flex max-w-[1240px] flex-wrap gap-x-6 gap-y-1 text-meta text-gris">
    <span>© {anio} {site.nombre} · {site.ciudad}</span>
    <span>{site.abogado} · {site.colegiatura}, {site.colegio}</span>
  </div>
</footer>
