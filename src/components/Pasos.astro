---
/**
 * Pasos numerados que aparecen uno detrás de otro, con una flecha entre cada
 * uno, cuando la lista entra en pantalla (portada y referidos).
 *
 * Sin JavaScript se ven todos, quietos: el estado oculto solo existe cuando el
 * script agrega .pasos-js. Con «reducir movimiento» tampoco hay animación.
 * El primer paso puede ir destacado, en tinta, con una etiqueta («Empieza aquí»).
 */
interface Paso { titulo: string; texto: string }
interface Props {
  pasos: Paso[];
  destacarPrimero?: boolean;
  etiquetaPrimero?: string;
}
const { pasos, destacarPrimero = false, etiquetaPrimero } = Astro.props;
---
<ol class="m-0 grid list-none gap-9 p-0 md:grid-cols-3 md:gap-6" data-pasos>
  {pasos.map((paso, i) => {
    const destacado = destacarPrimero && i === 0;
    const ultimo = i === pasos.length - 1;
    return (
      <li data-paso style={`--i: ${i}`} class="relative">
        <div class:list={['flex h-full flex-col gap-4 rounded-[20px] p-7', destacado ? 'bg-tinta text-blanco' : 'bg-niebla']}>
          <span class="flex items-center gap-3">
            <span class="relative flex h-12 w-12 items-center justify-center" aria-hidden="true">
              {destacado && <span class="pasos-pulso absolute inset-0 rounded-full bg-acento"></span>}
              <span class:list={[
                'relative flex h-12 w-12 items-center justify-center rounded-full text-[20px] font-semibold',
                destacado ? 'bg-acento text-fijo-oscuro' : 'bg-tinta text-blanco',
              ]}>{i + 1}</span>
            </span>
            {destacado && etiquetaPrimero && (
              <span class="rounded-full bg-blanco/15 px-3 py-1 text-[13px] font-medium text-blanco">{etiquetaPrimero}</span>
            )}
          </span>
          <h3 class:list={['m-0 text-[22px] leading-[1.2]', destacado ? 'text-blanco' : 'text-tinta']}>{paso.titulo}</h3>
          <p class:list={['m-0 text-base', destacado ? 'text-claro' : 'text-tenue']}>{paso.texto}</p>
        </div>
        {!ultimo && (
          <span
            aria-hidden="true"
            class="pasos-flecha absolute -bottom-7 left-9 z-10 flex h-9 w-9 rotate-90 items-center justify-center rounded-full bg-acento text-fijo-oscuro md:-right-[30px] md:bottom-auto md:left-auto md:top-1/2 md:-mt-[18px] md:rotate-0"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
          </span>
        )}
      </li>
    );
  })}
</ol>

<script>
  /* Prepara el estado oculto solo si hay JavaScript y lo dispara una vez, cuando
     la lista entra en pantalla. */
  document.querySelectorAll<HTMLElement>('[data-pasos]').forEach((lista) => {
    if (matchMedia('(prefers-reduced-motion: reduce)').matches || !('IntersectionObserver' in window)) return;
    lista.classList.add('pasos-js');
    const obs = new IntersectionObserver((entradas) => {
      entradas.forEach((e) => {
        if (e.isIntersecting) {
          lista.classList.add('en-vista');
          obs.disconnect();
        }
      });
    }, { threshold: 0.3 });
    obs.observe(lista);
  });
</script>
