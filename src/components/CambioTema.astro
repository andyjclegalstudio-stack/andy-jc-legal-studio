---
/**
 * El interruptor claro/oscuro. Sin elección guardada, el sitio sigue la
 * preferencia del sistema; al pulsar, se fija la contraria y se recuerda en
 * localStorage. El script de arranque va en Base.astro, antes de pintar, para
 * que no haya un destello claro al cargar en modo oscuro.
 */
---
<button
  type="button"
  data-cambio-tema
  aria-label="Cambiar a modo oscuro"
  aria-pressed="false"
  class="flex h-11 w-11 items-center justify-center rounded-[12px] border border-borde bg-white text-tinta transition-colors hover:bg-niebla"
>
  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" data-icono-luna>
    <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" />
  </svg>
  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" data-icono-sol class="hidden">
    <circle cx="12" cy="12" r="4" />
    <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
  </svg>
</button>

<script>
  const raiz = document.documentElement;
  const boton = document.querySelector<HTMLButtonElement>('[data-cambio-tema]');
  if (boton) {
    const luna = boton.querySelector<SVGElement>('[data-icono-luna]');
    const sol = boton.querySelector<SVGElement>('[data-icono-sol]');
    const esOscuro = () =>
      raiz.dataset.theme === 'dark' ||
      (!raiz.dataset.theme && window.matchMedia('(prefers-color-scheme: dark)').matches);
    const pintar = () => {
      const oscuro = esOscuro();
      luna?.classList.toggle('hidden', oscuro);
      sol?.classList.toggle('hidden', !oscuro);
      boton.setAttribute('aria-pressed', String(oscuro));
      boton.setAttribute('aria-label', oscuro ? 'Cambiar a modo claro' : 'Cambiar a modo oscuro');
      document.querySelector('meta[name="theme-color"]')?.setAttribute('content', oscuro ? '#0F1A26' : '#16283A');
    };
    boton.addEventListener('click', () => {
      const nuevo = esOscuro() ? 'light' : 'dark';
      raiz.dataset.theme = nuevo;
      try { localStorage.setItem('tema', nuevo); } catch {}
      pintar();
    });
    pintar();
  }
</script>
