---
import { wa } from '../lib/whatsapp';
interface Props {
  mensaje: string;
  variante?: 'primario' | 'secundario' | 'sobrio' | 'claro';
  class?: string;
  etiqueta?: string;
}
const {
  mensaje,
  variante = 'primario',
  class: clase = '',
  etiqueta = 'Escribir por WhatsApp',
} = Astro.props;

const base =
  'inline-flex items-center justify-center gap-2.5 rounded-[2px] px-6 py-3.5 text-base font-semibold no-underline transition-colors duration-150';
const variantes = {
  primario: 'bg-jade text-white hover:bg-tinta',
  secundario: 'border border-tinta/40 text-tinta hover:border-tinta hover:bg-niebla',
  sobrio: 'border border-white/30 text-white hover:bg-white hover:text-tinta',
  claro: 'bg-white text-tinta hover:bg-ambar',
};
---
<a
  href={wa(mensaje)}
  target="_blank"
  rel="noopener noreferrer"
  class={`${base} ${variantes[variante]} ${clase}`}
>
  <svg width="19" height="19" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="shrink-0">
    <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.9 9.9 0 0 0 4.79 1.22h.01c5.46 0 9.9-4.45 9.9-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2Zm0 18.15h-.01a8.2 8.2 0 0 1-4.19-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.2 8.2 0 0 1-1.26-4.38c0-4.54 3.7-8.23 8.25-8.23 2.2 0 4.27.86 5.83 2.41a8.19 8.19 0 0 1 2.41 5.83c0 4.54-3.7 8.23-8.24 8.23Zm4.52-6.16c-.25-.13-1.47-.72-1.69-.81-.23-.08-.39-.12-.56.13-.16.24-.64.8-.78.97-.15.16-.29.19-.53.06-.25-.12-1.05-.38-1.99-1.23-.74-.65-1.23-1.46-1.38-1.71-.14-.25-.01-.38.11-.5.11-.11.25-.29.37-.44.13-.15.17-.25.25-.41.09-.17.04-.31-.02-.44-.06-.12-.56-1.35-.77-1.84-.2-.49-.4-.42-.55-.43h-.48c-.16 0-.43.06-.65.31-.22.25-.85.83-.85 2.03s.87 2.35.99 2.51c.12.16 1.71 2.61 4.14 3.66.58.25 1.03.4 1.38.51.58.19 1.11.16 1.53.1.47-.07 1.47-.6 1.67-1.18.21-.58.21-1.07.15-1.18-.06-.11-.22-.17-.47-.29Z"/>
  </svg>
  {etiqueta}
</a>
