---
/**
 * El elemento memorable de la portada.
 * El monograma de la marca leído como diagrama: la D de DIADA abierta en sus dos
 * mitades. El asta recta es el Derecho Empresarial; la curva, el Derecho Digital.
 * Las dos zonas donde ambas se superponen van rellenas en jade — literalmente,
 * dónde se cruzan las dos áreas de práctica.
 * Un solo SVG estático. Cero JavaScript.
 */
import { D_PARTES, D_CURVA, VIEWBOX } from '../lib/monograma';
---

<figure class="m-0">
  <svg
    viewBox={VIEWBOX}
    class="w-full h-auto"
    role="img"
    aria-label="Diagrama: la D de DIADA separada en sus dos mitades. El asta recta representa el Derecho Empresarial y la curva el Derecho Digital; las dos zonas donde se cruzan aparecen resaltadas."
    xmlns="http://www.w3.org/2000/svg"
  >
    <defs>
      <clipPath id="recorte-asta">
        {D_PARTES.map((d) => <path d={d} />)}
      </clipPath>
    </defs>

    {/* Contornos: trazo de 1px real a cualquier escala. */}
    <g
      fill="none"
      stroke="var(--color-tinta)"
      stroke-width="1"
      vector-effect="non-scaling-stroke"
      opacity="0.38"
    >
      {D_PARTES.map((d) => <path d={d} />)}
      <path d={D_CURVA} />
    </g>

    {/* Las intersecciones. Único momento animado del sitio. */}
    <g clip-path="url(#recorte-asta)" class="cruce-entra">
      <path d={D_CURVA} fill="var(--color-jade)" />
    </g>

    {/* Etiquetas ancladas. Solo donde hay ancho real para leerlas. */}
    <g
      class="hidden lg:block"
      font-family="var(--font-sans)"
      font-size="17"
      fill="var(--color-tenue)"
    >
      {/* Cada guía sale de su propia altura y muere en la misma columna:
          así ninguna etiqueta choca con otra ni cruza el dibujo dos veces. */}
      <line
        x1="168" y1="110" x2="440" y2="110"
        stroke="var(--color-jade)" stroke-width="1" vector-effect="non-scaling-stroke"
        opacity="0.55"
      />
      <text x="448" y="104" fill="var(--color-jade)">Donde tu empresa opera hoy</text>

      <line
        x1="420" y1="258" x2="440" y2="258"
        stroke="var(--color-linea)" stroke-width="1" vector-effect="non-scaling-stroke"
      />
      <text x="448" y="252">Curva: Derecho Digital</text>

      <line
        x1="200" y1="330" x2="440" y2="330"
        stroke="var(--color-linea)" stroke-width="1" vector-effect="non-scaling-stroke"
      />
      <text x="448" y="324">Asta recta: Derecho Empresarial</text>

    </g>
  </svg>

  {/* Bajo lg el dibujo es chico: la leyenda va como texto, no encima del gráfico. */}
  <figcaption class="lg:hidden mt-6 text-meta text-tenue">
    <ul class="m-0 list-none p-0">
      <li class="flex items-start gap-3 border-t border-linea py-2.5">
        <span class="mt-1 h-2.5 w-2.5 shrink-0 border border-tinta/45" aria-hidden="true"></span>
        El asta recta: Derecho Empresarial
      </li>
      <li class="flex items-start gap-3 border-t border-linea py-2.5">
        <span
          class="mt-1 h-2.5 w-2.5 shrink-0 rounded-full border border-tinta/45"
          aria-hidden="true"></span>
        La curva: Derecho Digital
      </li>
      <li class="flex items-start gap-3 border-y border-linea py-2.5 text-jade">
        <span class="mt-1 h-2.5 w-2.5 shrink-0 bg-jade" aria-hidden="true"></span>
        El cruce: donde tu empresa opera hoy
      </li>
    </ul>
  </figcaption>
</figure>
