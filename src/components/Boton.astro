---
/**
 * Enlace con forma de botón. Para abrir WhatsApp usa BotonWhatsApp, que arma
 * el mensaje; este es para rutas internas y anclas.
 */
import { clasesBoton, type Variante } from '../lib/botones';

interface Props {
  href: string;
  variante?: Variante;
  compacto?: boolean;
  flecha?: boolean;
  class?: string;
}
const { href, variante = 'primario', compacto = false, flecha = false, class: clase = '' } = Astro.props;
---
<a href={href} class={`${clasesBoton(variante, compacto)} ${clase}`}>
  <slot />
  {flecha && (
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M5 12h14M13 6l6 6-6 6" />
    </svg>
  )}
</a>
