---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Boton from '../components/Boton.astro';
import BotonWhatsApp from '../components/BotonWhatsApp.astro';
import Marquesina from '../components/Marquesina.astro';
import Testimonios from '../components/Testimonios.astro';
import EncabezadoSeccion from '../components/EncabezadoSeccion.astro';
import Faq from '../components/Faq.astro';
import site from '../data/site.json';
import faq from '../data/faq.json';
import planes from '../data/planes.json';
import kit from '../data/kit.json';
import { frentes } from '../data/frentes.json';
import { esProximo, diaYMes, TIPOS } from '../lib/eventos';
import { soles, conPrecio } from '../lib/planes';
import { MENSAJE_GENERAL, MENSAJE_REUNION } from '../lib/whatsapp';

const servicios = (await getCollection('servicios')).sort((a, b) => a.data.orden - b.data.orden);
const slugs = new Set(servicios.map((s) => s.id));

const proximo = (await getCollection('academy'))
  .filter((e) => esProximo(e.data.fecha) && e.data.estado !== 'cerrado')
  .sort((a, b) => a.data.fecha.getTime() - b.data.fecha.getTime())[0];

/* Las palabras que rotan en la portada. La última repite la primera para
   que el salto de vuelta no se note. */
const palabras = ['tu empresa.', 'tus contratos.', 'tu prevención legal.', 'tu crecimiento.'];

const pilares = [
  {
    titulo: 'Equipo legal especializado',
    texto: 'Societario, contractual, laboral, tributario, penal de la empresa y digital, en un solo equipo que conoce tu negocio.',
  },
  {
    titulo: 'Visión de negocios',
    texto: 'Formación en dirección de empresas para asesorar pensando en rentabilidad, flujo de caja y crecimiento, no solo en la norma.',
  },
  {
    titulo: 'Red técnica aliada',
    texto: 'Contadores, ingenieros y consultores de negocio que entran cuando tu rubro lo pide, para que ninguna decisión quede suelta.',
  },
];

const minimo = Math.min(...conPrecio.map((p) => p.precio));
const maximo = Math.max(...conPrecio.map((p) => p.precio));

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'LegalService',
      '@id': `${Astro.site}#estudio`,
      description: site.descripcion,
      image: new URL('/og-image.png', Astro.site).href,
      priceRange: `S/ ${minimo} - S/ ${maximo} al mes`,
      areaServed: { '@type': 'Country', name: 'Perú' },
      knowsLanguage: 'es',
      hasOfferCatalog: {
        '@type': 'OfferCatalog',
        name: 'Servicios',
        itemListElement: [
          ...conPrecio.map((p) => ({
            '@type': 'Offer',
            name: `Plan ${p.nombre}`,
            description: p.para,
            price: String(p.precio),
            priceCurrency: 'PEN',
            eligibleCustomerType: 'Business',
            url: new URL('/planes/', Astro.site).href,
          })),
          ...servicios.map((s) => ({
            '@type': 'Offer',
            itemOffered: { '@type': 'Service', name: s.data.nombre, description: s.data.incluye },
          })),
        ],
      },
    },
    {
      '@type': 'FAQPage',
      '@id': `${Astro.site}#faq`,
      mainEntity: faq.map((f) => ({
        '@type': 'Question',
        name: f.pregunta,
        acceptedAnswer: { '@type': 'Answer', text: f.respuesta },
      })),
    },
  ],
};
---

<Base
  titulo="Díada Legal Studio | Área legal externa para empresas en Perú"
  descripcion="Un equipo de abogados especialistas en Derecho Empresarial y Digital, con visión de negocio y red de contadores e ingenieros, como área legal externa de tu empresa por una cuota mensual sin permanencia."
  mensajeFijo={MENSAJE_REUNION}
  jsonLd={jsonLd}
>
  {/* 1. Portada */}
  <section class="px-6 pb-[clamp(56px,7vw,96px)] pt-[clamp(40px,6vw,80px)]">
    <div class="mx-auto flex max-w-[1240px] flex-col gap-8">
      <p class="m-0 etiqueta text-gris">Área legal externa para micro y pequeñas empresas · Perú</p>
      <h1 class="m-0 text-portada text-tinta tracking-[-0.025em]">
        Tu área legal para<br />
        <span class="inline-block h-[1.1em] overflow-hidden border-b-4 border-acento align-bottom">
          <span class="rotar">
            {[...palabras, palabras[0]].map((p) => (
              <span class="block h-[1.1em] italic leading-[1.1em]">{p}</span>
            ))}
          </span>
        </span>
        <span class="sr-only">{palabras.join(' ')}</span>
      </h1>
      <div class="flex flex-wrap items-end justify-between gap-8">
        <p class="m-0 max-w-[600px] flex-[1_1_420px] text-[19px] leading-[1.6] text-tenue">
          Contrata un área legal completa para tu empresa, con abogados especialistas y una
          red de contadores e ingenieros que trabaja según tu rubro, por una cuota mensual y
          sin permanencia
        </p>
        <div class="flex flex-wrap gap-3">
          <Boton href="/diagnostico">Agendar reunión</Boton>
          <Boton href="/planes" variante="secundario" flecha class="border-transparent hover:border-transparent">
            Ver planes
          </Boton>
        </div>
      </div>
    </div>
  </section>

  {/* 2. Empresas, en movimiento */}
  <Marquesina nombres={site.clientes} />

  {/* 3. Los tres pilares */}
  <section class="px-6 py-[clamp(72px,9vw,128px)]" aria-labelledby="t-pilares">
    <div class="mx-auto flex max-w-[1240px] flex-col gap-14">
      <h2 id="t-pilares" class="m-0 max-w-[960px] text-[clamp(36px,4.6vw,64px)] leading-[1.05] text-tinta">
        No contratas un abogado, contratas un área legal de especialistas que se preocupa por tu negocio.
      </h2>
      <div class="flex flex-wrap gap-10">
        {pilares.map((p, i) => (
          <div class="flex min-w-0 flex-[1_1_300px] flex-col gap-3 border-t border-tinta pt-5">
            <span class="font-mono text-meta text-gris">{String(i + 1).padStart(2, '0')}</span>
            <strong class="text-[21px] font-semibold leading-snug">{p.titulo}</strong>
            <span class="text-base text-tenue">{p.texto}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* 4. Qué resolvemos */}
  <section class="bg-niebla px-6 py-[clamp(72px,9vw,120px)]" aria-labelledby="t-resolvemos">
    <div class="mx-auto flex max-w-[1240px] flex-col gap-10">
      <EncabezadoSeccion
        etiqueta="Qué resolvemos"
        titulo="Dos frentes, una sola área legal."
        entrada="Servicio pensado para empresas, no para personas naturales. Todo lo que una empresa necesita para operar, contratar y crecer."
      />
      <span id="t-resolvemos" class="sr-only">Qué resolvemos</span>

      <div class="grid gap-5 lg:grid-cols-2">
        {frentes.map((f) => (
          <article class="flex flex-col gap-5 rounded-[18px] border border-linea bg-white p-7 md:p-8">
            <div class="flex flex-col gap-2.5">
              <h3 class="m-0 font-display text-[clamp(28px,2.6vw,36px)] font-normal leading-[1.1]">{f.nombre}</h3>
              <p class="m-0 text-base text-tenue">{f.texto}</p>
            </div>
            <ul class="m-0 flex list-none flex-col divide-y divide-linea border-t border-linea p-0">
              {f.items.map((it) => (
                <li class="flex items-center justify-between gap-4 py-3.5 text-[16px]">
                  {'servicio' in it && it.servicio && slugs.has(it.servicio) ? (
                    <a href={`/servicios#${it.servicio}`} class="no-underline hover:underline">{it.nombre}</a>
                  ) : (
                    <span>{it.nombre}</span>
                  )}
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="shrink-0"><path d="M5 12l5 5L20 7" /></svg>
                </li>
              ))}
            </ul>
            <BotonWhatsApp
              mensaje={`Hola, vengo de la web. Tengo una consulta de ${f.nombre}.`}
              etiqueta={`Consultar sobre ${f.nombre.replace('Derecho ', '').toLowerCase()}`}
              variante="secundario"
              compacto
              class="self-start"
            />
          </article>
        ))}
      </div>
    </div>
  </section>

  {/* 5. Testimonios. Solo si hay reales en src/data/testimonios.json. */}
  <Testimonios />

  {/* 6. Planes, resumen */}
  <section class="sobre-tinta bg-tinta px-6 py-[clamp(72px,9vw,120px)] text-white" aria-labelledby="t-planes">
    <div class="mx-auto flex max-w-[1240px] flex-col gap-11">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <h2 id="t-planes" class="m-0 max-w-[700px] text-seccion text-white">Un plan mensual, sin permanencia, con todo tu equipo legal.</h2>
        <Boton href="/planes" variante="acento" compacto>Comparar planes</Boton>
      </div>
      <div class="flex flex-col border-t border-linea-oscura">
        {planes.planes.map((p) => (
          <a
            href={`/planes#${p.id}`}
            class="flex flex-wrap items-baseline justify-between gap-x-8 gap-y-3 border-b border-linea-oscura py-7 text-white no-underline"
          >
            <span class="flex flex-[0_0_220px] flex-wrap items-center gap-3 font-display text-[32px]">
              {p.nombre}
              {p.destacado && (
                <span class="rounded-full bg-acento px-2.5 py-1 font-sans text-[11px] font-bold uppercase tracking-[0.08em] text-fijo-oscuro">
                  Más elegido
                </span>
              )}
            </span>
            <span class="flex-[1_1_360px] text-base text-claro">{p.resumen}</span>
            <span class="text-[22px] font-semibold tabular-nums">
              {p.precio != null ? (
                <>{soles(p.precio)} <span class="text-[14px] font-normal text-claro">/ mes</span></>
              ) : (
                <span class="text-[16px] font-medium text-claro">Propuesta a medida</span>
              )}
            </span>
          </a>
        ))}
        <a
          href="/planes#kit"
          class="flex flex-wrap items-baseline justify-between gap-x-8 gap-y-3 border-b border-linea-oscura py-7 text-white no-underline"
        >
          <span class="flex flex-[0_0_220px] flex-wrap items-center gap-3 font-display text-[32px]">
            Kit de despegue
            <span class="rounded-full border border-white/40 px-2.5 py-1 font-sans text-[11px] font-bold uppercase tracking-[0.08em]">
              Pago único
            </span>
          </span>
          <span class="flex-[1_1_360px] text-base text-claro">Semáforo de riesgo, blindaje digital y hoja de ruta en {kit.plazo}. Para empezar sin cuota mensual.</span>
          <span class="text-[22px] font-semibold tabular-nums">{soles(kit.precio)}</span>
        </a>
      </div>
      <a href="/portal" class="inline-flex items-center gap-2 self-start text-base font-semibold text-white underline decoration-white/40 underline-offset-4 hover:decoration-white">
        Así se ve tu empresa en el portal del cliente
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
      </a>
    </div>
  </section>

  {/* 7. Academy, resumen */}
  <section class="px-6 py-[clamp(72px,9vw,120px)]" aria-labelledby="t-academy">
    <div class="mx-auto flex max-w-[1240px] flex-wrap items-center gap-12">
      <div class="flex min-w-0 flex-[1_1_420px] flex-col gap-4.5">
        <EncabezadoSeccion etiqueta="Díada Academy" titulo="Formación legal práctica para quienes deciden todos los días." />
        <span id="t-academy" class="sr-only">Academy</span>
        <p class="m-0 text-[17px] text-tenue">
          Charlas abiertas gratuitas, talleres prácticos y entrenamiento in company con los casos de tu propia empresa.
        </p>
        <Boton href="/academy" variante="secundario" compacto class="self-start">Ver agenda completa</Boton>
      </div>

      {proximo ? (
        <a
          href={`/academy/${proximo.id}`}
          class="flex min-w-0 flex-[1_1_460px] items-start gap-7 rounded-tarjeta border border-linea bg-niebla p-8 text-tinta no-underline"
        >
          <span class="flex h-[92px] w-[84px] shrink-0 flex-col items-center justify-center rounded-[14px] bg-tinta text-white">
            <span class="font-display text-[40px] leading-none">{diaYMes(proximo.data.fecha).dia}</span>
            <span class="font-mono text-[12px] uppercase tracking-[0.12em]">{diaYMes(proximo.data.fecha).mes}</span>
          </span>
          <span class="flex flex-col gap-2.5">
            <span class="font-mono text-[12px] text-gris">
              Próximo {TIPOS[proximo.data.tipo].toLowerCase()} · {proximo.data.lugar} · {proximo.data.duracion}
            </span>
            <strong class="font-display text-[28px] font-medium leading-[1.15]">{proximo.data.titulo}</strong>
            <span class="text-[15px] font-semibold underline">
              {proximo.data.estado === 'abierto' ? 'Reservar cupo' : 'Ver detalle'}
            </span>
          </span>
        </a>
      ) : (
        <div class="flex min-w-0 flex-[1_1_460px] flex-col gap-4 rounded-tarjeta border border-linea bg-niebla p-8">
          <span class="font-mono text-[12px] text-gris">Agenda</span>
          <strong class="font-display text-[28px] font-medium leading-[1.15]">
            No hay fecha abierta en este momento.
          </strong>
          <p class="m-0 text-base text-tenue">
            Avísanos por WhatsApp qué tema te interesa y lo agendamos en la siguiente edición.
          </p>
          <BotonWhatsApp
            mensaje="Hola, vengo de la web. Me gustaría que Academy dicte un taller sobre este tema:"
            etiqueta="Proponer un tema"
            variante="secundario"
            compacto
            class="self-start"
          />
        </div>
      )}
    </div>
  </section>

  {/* 8. Nosotros */}
  <section id="nosotros" class="scroll-mt-20 border-t border-linea px-6 py-[clamp(72px,9vw,120px)]" aria-labelledby="t-nosotros">
    <div class="mx-auto flex max-w-[1240px] flex-wrap items-start gap-14">
      <div class="flex min-w-0 flex-[1_1_440px] flex-col gap-5">
        <EncabezadoSeccion
          etiqueta="Nosotros"
          titulo="Más que abogados, aliados que entienden cómo funciona una empresa por dentro."
        />
        <span id="t-nosotros" class="sr-only">Nosotros</span>
      </div>
      <div class="flex min-w-0 flex-[1_1_480px] flex-col gap-5 text-lead leading-[1.7] text-tenue lg:pt-14">
        <p class="m-0">
          Díada Legal Studio nació para resolver un problema real de las micro y pequeñas
          empresas del Perú, la distancia entre las leyes y la realidad de hacer negocios
        </p>
        <p class="m-0">
          Somos un equipo de abogados especialistas en Derecho Empresarial y Derecho Digital,
          con formación en administración y dirección de empresas y una red de contadores,
          ingenieros y consultores de negocio que entra cuando tu rubro lo pide
        </p>
        <p class="m-0">
          No hablamos en idioma difícil ni llenamos de burocracia, traducimos la norma en
          decisiones para que protejas tu patrimonio, ordenes a tus socios y crezcas con
          tranquilidad, desde {site.ciudad.replace(', Perú', '')} y para todo el país
        </p>
      </div>
    </div>
  </section>

  {/* 9. Preguntas frecuentes */}
  <section class="bg-niebla px-6 py-[clamp(72px,9vw,120px)]" aria-labelledby="t-faq">
    <div class="mx-auto flex max-w-[860px] flex-col gap-8">
      <h2 id="t-faq" class="m-0 text-[clamp(34px,4vw,52px)] leading-[1.06] text-tinta">Preguntas frecuentes</h2>
      <Faq />
    </div>
  </section>

  {/* 10. Cierre */}
  <section id="contacto" class="scroll-mt-20 px-6 py-[clamp(80px,10vw,144px)] text-center">
    <div class="mx-auto flex max-w-[900px] flex-col items-center gap-6">
      <h2 class="m-0 text-cierre text-tinta tracking-[-0.025em]">Que un contrato no frene el negocio.</h2>
      <p class="m-0 text-lead text-tenue">
        Treinta minutos de reunión, sin costo. Si no hay nada que hacer, te lo decimos.
      </p>
      <div class="flex flex-wrap justify-center gap-3">
        <Boton href="/diagnostico" class="px-7">Agendar reunión</Boton>
        <BotonWhatsApp mensaje={MENSAJE_GENERAL} variante="secundario" icono class="px-7" />
      </div>
    </div>
  </section>
</Base>
