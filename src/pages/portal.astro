---
/**
 * Demostración del portal de clientes. Es una página estática con datos de
 * ejemplo: muestra cómo vería su empresa un cliente con plan. No hay acceso,
 * ni base de datos, ni archivos reales; los botones de descarga no descargan.
 * El nombre de la empresa se toma de ?empresa= para que cada prospecto vea el suyo.
 */
import Base from '../layouts/Base.astro';
import Chip from '../components/Chip.astro';
import BotonWhatsApp from '../components/BotonWhatsApp.astro';
import demo from '../data/portal-demo.json';
import site from '../data/site.json';
import { fechaLarga } from '../lib/eventos';

const f = (iso: string) => fechaLarga(new Date(iso));
const hoy = new Date('2026-10-14');
const dias = (iso: string) => Math.round((new Date(iso).getTime() - hoy.getTime()) / 86400000);
/* La etiqueta de cada vencimiento se calcula acá: el parser de plantillas de
   Astro confunde los «<» de una comparación con una etiqueta. */
const vencimientos = demo.vencimientos.map((v) => {
  const n = dias(v.fecha);
  const etiqueta = n < 0 ? 'Vencido' : n === 0 ? 'Hoy' : n <= 60 ? `${n} días` : `${Math.round(n / 30)} meses`;
  return { ...v, etiqueta, pronto: n <= 30 };
});
const iniciales = (n: string) => {
  const p = n.split(/\s+/).filter((w) => !/^(de|del|la|los|las|y|e|s\.a\.c\.|s\.a\.|e\.i\.r\.l\.)$/i.test(w));
  return ((p[0]?.[0] ?? '') + (p.length > 1 ? p[1][0] : '')).toUpperCase();
};
const MENSAJE = 'Hola, vengo de la web. Vi la demostración del portal y quiero esto para mi empresa.';
---

<Base
  titulo="Así se ve tu empresa en el portal del cliente | Díada Legal Studio"
  descripcion="Demostración del portal de clientes: documentos entregados, pendientes, vencimientos y cupo del plan de tu empresa, en un solo lugar."
  mensajeFijo={MENSAJE}
>
  <section class="px-6 pb-[clamp(72px,9vw,112px)] pt-[clamp(40px,6vw,80px)]">
    <div class="mx-auto flex max-w-[1240px] flex-col gap-8">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <div class="flex max-w-[640px] flex-col gap-3.5">
          <p class="m-0 etiqueta text-gris">Portal del cliente · demostración</p>
          <h1 class="m-0 text-[clamp(36px,4.6vw,64px)] leading-[1.05] tracking-[-0.02em] text-tinta">
            Así se ve <span class="italic" data-empresa>{demo.empresa}</span> con un plan.
          </h1>
          <p class="m-0 text-lead text-tenue">
            Documentos entregados, pendientes, vencimientos y el cupo del mes, en un solo lugar.
            Los datos de esta página son de ejemplo.
          </p>
        </div>
        <BotonWhatsApp mensaje={MENSAJE} etiqueta="Quiero esto para mi empresa" />
      </div>

      {/* El tablero */}
      <div class="overflow-hidden rounded-[22px] border border-borde bg-white">
        {/* Barra superior del portal */}
        <div class="flex flex-wrap items-center justify-between gap-4 border-b border-linea bg-niebla px-6 py-4">
          <div class="flex items-center gap-3.5">
            <span class="flex h-11 w-11 items-center justify-center rounded-[10px] bg-tinta font-display text-[19px] font-medium text-white" data-iniciales aria-hidden="true">
              {iniciales(demo.empresa)}
            </span>
            <div class="flex flex-col">
              <strong class="text-[15px] font-semibold" data-empresa>{demo.empresa}</strong>
              <span class="text-meta text-gris">Plan {demo.plan} · {demo.mes}</span>
            </div>
          </div>
          <div class="flex items-center gap-3">
            <Chip class="bg-acento text-fijo-oscuro">Demostración</Chip>
            <span class="hidden text-meta text-gris sm:inline">Equipo responsable: {site.nombre}</span>
          </div>
        </div>

        <div class="grid gap-px bg-linea lg:grid-cols-[1.4fr_1fr]">
          {/* Documentos */}
          <section class="bg-white p-6 lg:row-span-2" aria-labelledby="t-documentos">
            <div class="flex items-baseline justify-between gap-4">
              <h2 id="t-documentos" class="m-0 font-display text-[26px] font-medium">Documentos entregados</h2>
              <span class="text-meta text-gris">{demo.documentos.length} archivos</span>
            </div>
            <ul class="m-0 mt-4 list-none divide-y divide-linea p-0">
              {demo.documentos.map((d) => (
                <li class="flex flex-wrap items-center justify-between gap-x-6 gap-y-2 py-4">
                  <span class="flex min-w-0 flex-[1_1_260px] flex-col gap-0.5">
                    <strong class="text-[15px] font-semibold">{d.titulo}</strong>
                    <span class="text-meta text-gris">{d.categoria} · {d.version} · entregado el {f(d.fecha)}</span>
                  </span>
                  <span
                    class="inline-flex min-h-10 items-center gap-2 rounded-full border-[1.5px] border-tinta px-4 text-[14px] font-semibold"
                    title="En la demostración no hay archivos reales"
                  >
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 4v12M6 10l6 6 6-6M5 20h14" /></svg>
                    Descargar
                  </span>
                </li>
              ))}
            </ul>
          </section>

          {/* Cupo del mes */}
          <section class="bg-white p-6" aria-labelledby="t-cupo">
            <h2 id="t-cupo" class="m-0 font-display text-[26px] font-medium">Cupo del mes</h2>
            <ul class="m-0 mt-4 flex list-none flex-col gap-4 p-0">
              {demo.cupo.map((c) => (
                <li class="flex flex-col gap-1.5">
                  <span class="flex justify-between text-[14px]">
                    <span class="font-semibold">{c.nombre}</span>
                    <span class="text-gris tabular-nums">{c.total ? `${c.usado} de ${c.total}` : `${c.usado} usados · sin tope`}</span>
                  </span>
                  <span class="block h-1.5 overflow-hidden rounded-full bg-linea" aria-hidden="true">
                    <span class="block h-full rounded-full bg-tinta" style={`width:${c.total ? Math.round((c.usado / c.total) * 100) : 100}%`}></span>
                  </span>
                </li>
              ))}
            </ul>
          </section>

          {/* Vencimientos */}
          <section class="bg-white p-6" aria-labelledby="t-vencimientos">
            <h2 id="t-vencimientos" class="m-0 font-display text-[26px] font-medium">Vencimientos</h2>
            <ul class="m-0 mt-4 list-none divide-y divide-linea p-0">
              {vencimientos.map((v) => (
                <li class="flex items-center justify-between gap-4 py-3.5">
                  <span class="flex flex-col gap-0.5">
                    <strong class="text-[15px] font-semibold">{v.titulo}</strong>
                    <span class="text-meta text-gris">{f(v.fecha)}</span>
                  </span>
                  <Chip class={v.pronto ? 'bg-acento text-fijo-oscuro' : 'border border-linea-fuerte text-gris'}>{v.etiqueta}</Chip>
                </li>
              ))}
            </ul>
          </section>

          {/* Pendientes */}
          <section class="bg-white p-6 lg:col-span-2" aria-labelledby="t-pendientes">
            <h2 id="t-pendientes" class="m-0 font-display text-[26px] font-medium">Pendientes</h2>
            <ul class="m-0 mt-4 list-none divide-y divide-linea p-0">
              {demo.pendientes.map((p) => (
                <li class="flex flex-wrap items-center justify-between gap-x-6 gap-y-2 py-3.5">
                  <span class="flex min-w-0 flex-[1_1_320px] items-center gap-3">
                    <span aria-hidden="true" class="h-4 w-4 shrink-0 rounded-[4px] border-[1.5px] border-linea-fuerte"></span>
                    <strong class="text-[15px] font-semibold">{p.titulo}</strong>
                  </span>
                  <span class="flex items-center gap-3 text-meta text-gris">
                    <Chip class={p.responsable === 'estudio' ? 'bg-tinta text-white' : 'border border-tinta text-tinta'}>
                      {p.responsable === 'estudio' ? 'Lo hace el estudio' : 'Te toca a ti'}
                    </Chip>
                    <span>vence el {f(p.vence)}</span>
                  </span>
                </li>
              ))}
            </ul>
          </section>
        </div>
      </div>

      <div class="flex flex-wrap items-center justify-between gap-6 border-t border-linea pt-8">
        <p class="m-0 max-w-[60ch] text-base text-tenue">
          Esta es una demostración con datos inventados. El portal real llega con el plan: cada
          empresa entra con su correo y ve solo lo suyo.
        </p>
        <div class="flex flex-wrap gap-3">
          <BotonWhatsApp mensaje={MENSAJE} etiqueta="Quiero esto para mi empresa" />
          <a href="/planes" class="inline-flex min-h-[52px] items-center justify-center rounded-full border-[1.5px] border-tinta px-6 text-base font-semibold no-underline hover:bg-niebla">Ver los planes</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<script>
  /* ?empresa=Minicash%20Los%20Andes → el tablero muestra ese nombre y sus iniciales.
     Se escribe con textContent: nunca se interpreta como HTML. */
  const nombre = new URLSearchParams(location.search).get('empresa')?.trim().slice(0, 60);
  if (nombre) {
    document.querySelectorAll<HTMLElement>('[data-empresa]').forEach((el) => { el.textContent = nombre; });
    const p = nombre.split(/\s+/).filter((w) => !/^(de|del|la|los|las|y|e|s\.a\.c\.|s\.a\.|e\.i\.r\.l\.)$/i.test(w));
    const ini = ((p[0]?.[0] ?? '') + (p.length > 1 ? p[1][0] : '')).toUpperCase();
    document.querySelectorAll<HTMLElement>('[data-iniciales]').forEach((el) => { el.textContent = ini; });
    document.title = `Así se ve ${nombre} en el portal del cliente | Díada Legal Studio`;
  }
</script>
