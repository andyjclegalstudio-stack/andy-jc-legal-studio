---
/**
 * El portal del cliente en acción, para la portada (docs/DESIGN.md §6 y §7).
 * Es una réplica en HTML de la demostración de /plataforma, con datos de EJEMPLO de
 * src/data/portal-demo.json, y lo dice en un rótulo visible.
 *
 * Movimiento en CSS puro (global.css, «portal en acción»): los chips pasan de su
 * estado inicial al final, las barras de avance se llenan y dos avisos flotan.
 * Sin JavaScript se ve igual, quieto. Con «reducir movimiento» queda quieto.
 */
import demo from '../data/portal-demo.json';

const iconos: Record<string, string> = {
  contrato: '<path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5"/><path d="M9 13h6M9 17h4"/>',
  escudo: '<path d="M12 3l7 3v6c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6z"/><path d="M9 12l2 2 4-4"/>',
  tramite: '<path d="M3 21h18"/><path d="M5 21V10M19 21V10M9.5 21V10M14.5 21V10"/><path d="M12 3l9 5H3z"/>',
};

const tonos = {
  ok: 'bg-ok/12 text-ok',
  pendiente: 'bg-pendiente/12 text-pendiente',
};

const saldoPuntos = demo.puntos.saldo;
---
<div class="relative">
  <div
    data-ui
    class="overflow-hidden rounded-[20px] border border-linea bg-blanco"
    aria-label={`Demostración del portal del cliente de ${demo.empresa}`}
    role="img"
  >
    {/* Barra superior del portal */}
    <div class="flex items-center justify-between gap-3 border-b border-linea px-4 py-3 sm:px-5">
      <div class="flex min-w-0 items-center gap-2.5">
        <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-lg bg-tinta text-[13px] font-semibold text-blanco">D</span>
        <span class="truncate text-[14px] font-semibold text-tinta">{demo.empresa}</span>
      </div>
      <span class="shrink-0 rounded-full bg-niebla px-2.5 py-1 text-[12px] font-medium text-gris">Demostración</span>
    </div>

    <div class="flex flex-col gap-4 p-4 sm:p-5">
      <div class="flex items-baseline justify-between gap-3">
        <p class="m-0 text-[16px] font-semibold text-tinta">Encargos en curso</p>
        <p class="m-0 text-[13px] text-gris">Plan {demo.plan}</p>
      </div>

      <ul class="m-0 grid list-none gap-3 p-0 sm:grid-cols-3">
        {demo.encargos.map((e, i) => (
          <li class="portal-tarjeta flex flex-col gap-3 rounded-2xl bg-niebla p-4" style={`--d: ${i * 1.2}s`}>
            <span class="flex h-9 w-9 items-center justify-center rounded-xl bg-blanco text-tinta">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={iconos[e.icono]} />
            </span>
            <span class="min-h-[2.6em] text-[14px] font-semibold leading-[1.3] text-tinta">{e.titulo}</span>
            <span class="grid items-start justify-items-start">
              <span class:list={[e.estado !== e.estadoFinal && 'portal-chip-inicial', 'col-start-1 row-start-1 whitespace-nowrap rounded-full px-2.5 py-1 text-[12px] font-medium', tonos.pendiente]}>
                {e.estado}
              </span>
              {e.estado !== e.estadoFinal && (
                <span class:list={['portal-chip-final col-start-1 row-start-1 whitespace-nowrap rounded-full px-2.5 py-1 text-[12px] font-medium', tonos[e.tono as keyof typeof tonos]]}>
                  {e.estadoFinal}
                </span>
              )}
            </span>
            <span class="text-[12px] text-gris">Última actividad · {e.actividad}</span>
            <span class="block h-1.5 overflow-hidden rounded-full bg-linea">
              <span class="portal-avance block h-full rounded-full bg-tinta" style={`width: ${e.avance}%`}></span>
            </span>
          </li>
        ))}
      </ul>

      {/* Puntos Díada */}
      <div class="flex items-center justify-between gap-4 rounded-2xl bg-tinta px-4 py-3">
        <span class="flex items-center gap-2.5 text-[13px] font-medium text-blanco">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="text-acento"><path d="M12 3l2.6 5.6 6.1.7-4.5 4.2 1.2 6L12 16.5 6.6 19.5l1.2-6L3.3 9.3l6.1-.7z" /></svg>
          Tus puntos Díada
        </span>
        <span class="font-mono text-[15px] font-semibold text-acento">{saldoPuntos} puntos</span>
      </div>
      </div>
    </div>
  </div>

  {/* Dos avisos que flotan fuera del marco. Decorativos: lo que dicen ya está arriba. */}
  <span aria-hidden="true" class="portal-flota absolute -left-3 -top-4 hidden items-center gap-2 rounded-full bg-tinta px-3.5 py-2 text-[13px] font-medium text-blanco sm:flex">
    <span class="h-2 w-2 rounded-full bg-acento"></span>
    Nuevo documento en tu portal
  </span>
  <span aria-hidden="true" class="portal-flota absolute -bottom-4 -right-3 hidden items-center gap-2 rounded-full bg-acento px-3.5 py-2 text-[13px] font-semibold text-fijo-oscuro sm:flex" style="--d: 1.5s">
    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l5 5L20 7" /></svg>
    Contrato entregado
  </span>
</div>
