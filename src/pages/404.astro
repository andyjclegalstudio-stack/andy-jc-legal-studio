---
import Base from '../layouts/Base.astro';
import BotonWhatsApp from '../components/BotonWhatsApp.astro';
---

<Base
  titulo="Página no encontrada — Díada Legal Studio"
  descripcion="La dirección que buscabas no existe en este sitio. Vuelve al inicio o escribe por WhatsApp."
>
  <section class="contenedor py-24 md:py-32">
    <p class="m-0 etiqueta text-gris">Error 404</p>
    <h1 class="mt-3 mb-0 max-w-[20ch] text-[clamp(40px,5.2vw,76px)] leading-[1.04] tracking-[-0.025em] text-tinta">
      Esta dirección no existe
    </h1>
    <p class="medida mt-7 mb-0 text-lead text-tenue">
      Puede que el enlace esté mal escrito o que la página se haya movido. Si llegaste
      buscando un taller de Academy que ya se dictó, escríbeme y te digo si hay grabación.
    </p>
    <div class="mt-10 flex flex-wrap gap-4">
      <BotonWhatsApp mensaje="Hola, vengo de la web. Llegué a una página que no existe y estaba buscando:" />
      <a
        href="/"
        class="inline-flex items-center justify-center rounded-full border-[1.5px] border-tinta px-6 py-3.5 text-base font-semibold text-tinta no-underline transition-colors hover:bg-niebla"
      >
        Volver al inicio
      </a>
    </div>
  </section>
</Base>
