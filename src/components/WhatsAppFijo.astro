---
import { wa } from '../lib/whatsapp';
interface Props { mensaje: string }
const { mensaje } = Astro.props;
---
<!-- Barra fija solo en el celular: el ícono abre WhatsApp y el botón lleva al diagnóstico. -->
<div class="fixed inset-x-0 bottom-0 z-40 flex gap-2.5 border-t border-borde bg-white px-4 pb-5 pt-3 md:hidden">
  <a
    href={wa(mensaje)}
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Escribir por WhatsApp"
    class="flex h-[52px] w-[52px] shrink-0 items-center justify-center rounded-full border-[1.5px] border-tinta"
  >
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M21 12a9 9 0 0 1-13.5 7.8L3 21l1.2-4.4A9 9 0 1 1 21 12z" />
    </svg>
  </a>
  <a
    href="/diagnostico"
    class="flex min-h-[52px] flex-1 items-center justify-center rounded-full bg-acento text-base font-bold text-fijo-oscuro no-underline"
  >
    Agendar diagnóstico gratuito
  </a>
</div>
