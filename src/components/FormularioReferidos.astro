---
import site from '../data/site.json';

/**
 * Este formulario NO envía nada a ningún servidor. No hay action, no hay fetch.
 * El botón es un enlace a wa.me y un script de 12 líneas le reescribe el texto
 * a medida que escribes. Con JavaScript desactivado el enlace sigue funcionando
 * con un mensaje genérico.
 */
const baseMensaje = 'Hola, vengo de la web. Quiero referir a una empresa al estudio.';
const hrefInicial = `https://wa.me/${site.whatsapp}?text=${encodeURIComponent(baseMensaje)}`;
---
<form
  id="form-referidos"
  class="mt-10 max-w-[46rem]"
  onsubmit="return false"
  aria-describedby="nota-referidos"
>
  <p id="nota-referidos" class="m-0 mb-8 text-meta text-tenue">
    Nada de lo que escribas aquí se envía a ningún servidor. Los campos solo arman el
    mensaje de WhatsApp que se abre en tu teléfono, y puedes revisarlo antes de enviarlo.
  </p>

  <div class="grid gap-6 sm:grid-cols-2">
    <div class="flex flex-col gap-2">
      <label for="ref-nombre" class="text-meta font-semibold text-tinta">Tu nombre</label>
      <input
        id="ref-nombre"
        name="nombre"
        type="text"
        autocomplete="name"
        placeholder="María Chávez"
        class="rounded-full border border-linea-fuerte bg-white px-4 py-3 text-base text-tinta placeholder:text-tinta/35 focus:border-tinta"
      />
    </div>

    <div class="flex flex-col gap-2">
      <label for="ref-empresa" class="text-meta font-semibold text-tinta">Empresa referida</label>
      <input
        id="ref-empresa"
        name="empresa"
        type="text"
        autocomplete="organization"
        placeholder="Andina Logística S.A.C."
        class="rounded-full border border-linea-fuerte bg-white px-4 py-3 text-base text-tinta placeholder:text-tinta/35 focus:border-tinta"
      />
    </div>

    <div class="flex flex-col gap-2">
      <label for="ref-contacto" class="text-meta font-semibold text-tinta">Persona de contacto</label>
      <input
        id="ref-contacto"
        name="contacto"
        type="text"
        placeholder="Nombre y cargo"
        class="rounded-full border border-linea-fuerte bg-white px-4 py-3 text-base text-tinta placeholder:text-tinta/35 focus:border-tinta"
      />
    </div>

    <div class="flex flex-col gap-2 sm:col-span-2">
      <label for="ref-necesita" class="text-meta font-semibold text-tinta">Qué necesita</label>
      <textarea
        id="ref-necesita"
        name="necesita"
        rows="4"
        placeholder="Están por lanzar una app y no tienen términos ni política de privacidad."
        class="rounded-full border border-linea-fuerte bg-white px-4 py-3 text-base text-tinta placeholder:text-tinta/35 focus:border-tinta"
      ></textarea>
    </div>
  </div>

  <a
    id="ref-enviar"
    href={hrefInicial}
    target="_blank"
    rel="noopener noreferrer"
    class="mt-8 inline-flex items-center justify-center gap-2.5 rounded-full bg-tinta px-6 py-3.5 text-base font-semibold text-white no-underline transition-colors hover:bg-tinta-oscura"
  >
    <svg width="19" height="19" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.9 9.9 0 0 0 4.79 1.22h.01c5.46 0 9.9-4.45 9.9-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2Zm0 18.15h-.01a8.2 8.2 0 0 1-4.19-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.2 8.2 0 0 1-1.26-4.38c0-4.54 3.7-8.23 8.25-8.23 2.2 0 4.27.86 5.83 2.41a8.19 8.19 0 0 1 2.41 5.83c0 4.54-3.7 8.23-8.24 8.23Zm4.52-6.16c-.25-.13-1.47-.72-1.69-.81-.23-.08-.39-.12-.56.13-.16.24-.64.8-.78.97-.15.16-.29.19-.53.06-.25-.12-1.05-.38-1.99-1.23-.74-.65-1.23-1.46-1.38-1.71-.14-.25-.01-.38.11-.5.11-.11.25-.29.37-.44.13-.15.17-.25.25-.41.09-.17.04-.31-.02-.44-.06-.12-.56-1.35-.77-1.84-.2-.49-.4-.42-.55-.43h-.48c-.16 0-.43.06-.65.31-.22.25-.85.83-.85 2.03s.87 2.35.99 2.51c.12.16 1.71 2.61 4.14 3.66.58.25 1.03.4 1.38.51.58.19 1.11.16 1.53.1.47-.07 1.47-.6 1.67-1.18.21-.58.21-1.07.15-1.18-.06-.11-.22-.17-.47-.29Z"/>
    </svg>
    Abrir WhatsApp con estos datos
  </a>
</form>

<script is:inline define:vars={{ numero: site.whatsapp, base: baseMensaje }}>
  (() => {
    const form = document.getElementById('form-referidos');
    const boton = document.getElementById('ref-enviar');
    if (!form || !boton) return;
    const v = (id) => (document.getElementById(id)?.value || '').trim();
    const actualizar = () => {
      const lineas = [base];
      if (v('ref-nombre')) lineas.push(`Mi nombre: ${v('ref-nombre')}`);
      if (v('ref-empresa')) lineas.push(`Empresa referida: ${v('ref-empresa')}`);
      if (v('ref-contacto')) lineas.push(`Persona de contacto: ${v('ref-contacto')}`);
      if (v('ref-necesita')) lineas.push(`Qué necesita: ${v('ref-necesita')}`);
      boton.href = `https://wa.me/${numero}?text=${encodeURIComponent(lineas.join('\n'))}`;
    };
    form.addEventListener('input', actualizar);
    actualizar();
  })();
</script>
