---
/**
 * El logotipo: «Díada», un filete vertical y «Legal Studio» en versalitas
 * espaciadas. Es la propuesta A del tablero de marca, la que se aplica en la web.
 *
 * Es texto compuesto, no imagen: escala con la tipografía y se lee con
 * cualquier lector de pantalla. El filete va con aria-hidden porque no dice nada.
 */
interface Props {
  tamano?: 'cabecera' | 'pie';
  sobreTinta?: boolean;
  class?: string;
}
const { tamano = 'cabecera', sobreTinta = false, class: clase = '' } = Astro.props;

const medidas = {
  cabecera: {
    nombre: 'text-[25px] md:text-[30px]',
    filete: 'h-5 md:h-6',
    bajada: 'text-[9.5px] tracking-[0.22em] md:text-[11px] md:tracking-[0.24em]',
    hueco: 'gap-2.5 md:gap-3.5',
  },
  pie: {
    nombre: 'text-[26px]',
    filete: 'h-5',
    bajada: 'text-[10px] tracking-[0.24em]',
    hueco: 'gap-3',
  },
}[tamano];

const color = sobreTinta ? 'text-white' : 'text-tinta';
const filete = sobreTinta ? 'bg-white' : 'bg-tinta';
---
<span class:list={['inline-flex items-center', medidas.hueco, color, clase]}>
  <span class:list={['font-display font-medium leading-none tracking-[-0.015em]', medidas.nombre]}>
    Díada
  </span>
  <span aria-hidden="true" class:list={['w-px shrink-0', medidas.filete, filete]}></span>
  <span class:list={['font-sans font-semibold uppercase leading-none', medidas.bajada]}>
    Legal Studio
  </span>
</span>
