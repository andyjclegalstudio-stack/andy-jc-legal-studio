---
/**
 * Una fila de la agenda de Academy: día y mes a la izquierda, tipo y datos,
 * título, precio y la flecha. Toda la fila es el enlace a la ficha.
 */
import Chip from './Chip.astro';
import { diaYMes, ESTADOS, TIPOS, type Estado } from '../lib/eventos';

interface Props {
  slug: string;
  titulo: string;
  tipo: string;
  fecha: Date;
  hora: string;
  duracion: string;
  lugar: string;
  precio: string;
  cupos?: number;
  estado: Estado;
}
const { slug, titulo, tipo, fecha, hora, duracion, lugar, precio, cupos, estado } = Astro.props;

const { dia, mes } = diaYMes(fecha);
const meta = [lugar, `${hora}`, duracion, cupos ? `${cupos} cupos` : null].filter(Boolean).join(' · ');
const e = ESTADOS[estado];
---
<a
  href={`/academy/${slug}`}
  data-tipo={tipo}
  class="flex flex-wrap items-center gap-x-8 gap-y-4 border-b border-linea py-6 text-tinta no-underline md:py-7"
>
  <span class="flex w-[72px] shrink-0 flex-col gap-0.5 md:w-24">
    <span class="font-display text-[36px] leading-none md:text-[44px]">{dia}</span>
    <span class="font-mono text-[12px] uppercase tracking-[0.12em] text-gris">{mes}</span>
  </span>

  <span class="flex min-w-0 flex-[1_1_320px] flex-col gap-2">
    <span class="flex flex-wrap items-center gap-2.5">
      <Chip>{TIPOS[tipo]}</Chip>
      <span class="text-[14px] text-gris">{meta}</span>
    </span>
    <strong class="font-display text-[22px] font-medium leading-[1.2] md:text-[27px]">{titulo}</strong>
  </span>

  <span class="flex shrink-0 flex-col items-start gap-1.5 md:w-[200px]">
    <span class="text-lead font-semibold">{precio}</span>
    <Chip class={e.chip}>{e.etiqueta}</Chip>
  </span>

  <span
    class="ml-auto hidden h-12 w-12 shrink-0 items-center justify-center rounded-full bg-tinta md:inline-flex"
    aria-hidden="true"
  >
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M5 12h14M13 6l6 6-6 6" />
    </svg>
  </span>
</a>
