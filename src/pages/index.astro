---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Boton from '../components/Boton.astro';
import BotonWhatsApp from '../components/BotonWhatsApp.astro';
import Marquesina from '../components/Marquesina.astro';
import Testimonios from '../components/Testimonios.astro';
import EncabezadoSeccion from '../components/EncabezadoSeccion.astro';
import Faq from '../components/Faq.astro';
import site from '../data/site.json';
import faq from '../data/faq.json';
import planes from '../data/planes.json';
import { areas } from '../data/areas.json';
import { esProximo, diaYMes, TIPOS } from '../lib/eventos';
import { soles } from '../lib/planes';
import { MENSAJE_DIAGNOSTICO, MENSAJE_GENERAL } from '../lib/whatsapp';

const servicios = (await getCollection('servicios')).sort((a, b) => a.data.orden - b.data.orden);

const proximo = (await getCollection('academy'))
  .filter((e) => esProximo(e.data.fecha) && e.data.estado !== 'cerrado')
  .sort((a, b) => a.data.fecha.getTime() - b.data.fecha.getTime())[0];

const palabras = ['contratos.', 'privacidad.', 'marcas.', 'cumplimiento.'];

const principios = [
  {
    titulo: 'Precio cerrado antes de empezar',
    texto: 'Sabes cuánto pagas por cada contrato o política. Sin sorpresas al cierre del mes.',
  },
  {
    titulo: 'Plazo comprometido por escrito',
    texto: 'Cada encargo tiene fecha de entrega. Si cambia, te avisamos antes, no después.',
  },
  {
    titulo: 'Un abogado responsable',
    texto: 'Hablas siempre con quien redacta tus documentos. Nadie te deriva.',
  },
];

const redes = site.redes as { nombre: string; url: string }[];
const linkedin = redes.find((r) => /linkedin/i.test(r.nombre));
const minimo = Math.min(...planes.planes.map((p) => p.precio));
const maximo = Math.max(...planes.planes.map((p) => p.precio));

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'LegalService',
      '@id': `${Astro.site}#estudio`,
      name: site.nombre,
      description: site.descripcion,
      url: Astro.site?.href,
      image: new URL('/og-image.png', Astro.site).href,
      email: site.correo,
      telephone: `+${site.whatsapp}`,
      priceRange: `S/ ${minimo} - S/ ${maximo} al mes`,
      areaServed: { '@type': 'Country', name: 'Perú' },
      address: { '@type': 'PostalAddress', addressLocality: 'Huánuco', addressCountry: 'PE' },
      knowsLanguage: 'es',
      founder: {
        '@type': 'Person',
        name: site.abogado,
        jobTitle: 'Abogado',
        memberOf: { '@type': 'Organization', name: site.colegio },
      },
      hasOfferCatalog: {
        '@type': 'OfferCatalog',
        name: 'Servicios',
        itemListElement: [
          ...planes.planes.map((p) => ({
            '@type': 'Offer',
            name: `Plan ${p.nombre}`,
            description: p.para,
            price: String(p.precio),
            priceCurrency: 'PEN',
            eligibleCustomerType: 'Business',
            url: new URL('/planes/', Astro.site).href,
          })),
          ...servicios.map((s) => ({
            '@type': 'Offer',
            itemOffered: { '@type': 'Service', name: s.data.nombre, description: s.data.incluye },
          })),
        ],
      },
    },
    {
      '@type': 'FAQPage',
      '@id': `${Astro.site}#faq`,
      mainEntity: faq.map((f) => ({
        '@type': 'Question',
        name: f.pregunta,
        acceptedAnswer: { '@type': 'Answer', text: f.respuesta },
      })),
    },
  ],
};
---

<Base
  titulo="Díada Legal Studio — Tu área legal externa | Derecho empresarial y digital en Perú"
  descripcion="Contratos, datos personales, marcas y cumplimiento para empresas que venden, contratan y tratan datos todos los meses. Documentos terminados, con precio cerrado y plazo por escrito."
  mensajeFijo={MENSAJE_DIAGNOSTICO}
  jsonLd={jsonLd}
>
  {/* 1. Portada */}
  <section class="px-6 pb-[clamp(56px,7vw,96px)] pt-[clamp(64px,10vw,144px)]">
    <div class="mx-auto flex max-w-[1240px] flex-col gap-8">
      <p class="m-0 etiqueta text-gris">Derecho empresarial y digital · Perú</p>
      <h1 class="m-0 text-portada text-tinta tracking-[-0.025em]">
        Tu área legal externa<br />para{' '}
        <span class="inline-block h-[1.1em] overflow-hidden border-b-4 border-acento align-bottom">
          <span class="rotar">
            {[...palabras, palabras[0]].map((p) => (
              <span class="block h-[1.1em] italic leading-[1.1em]">{p}</span>
            ))}
          </span>
        </span>
        <span class="sr-only">{palabras.join(' ')}</span>
      </h1>
      <div class="flex flex-wrap items-end justify-between gap-8">
        <p class="m-0 max-w-[560px] flex-[1_1_420px] text-[19px] leading-[1.6] text-tenue">
          Documentos terminados, con precio cerrado y plazo por escrito. Para empresas que
          venden, contratan y tratan datos todos los meses.
        </p>
        <div class="flex flex-wrap gap-3">
          <Boton href="/diagnostico">Agendar diagnóstico gratuito</Boton>
          <Boton href="/planes" variante="secundario" flecha class="border-transparent hover:border-transparent">
            Ver planes
          </Boton>
        </div>
      </div>
    </div>
  </section>

  {/* 2. Empresas, en movimiento */}
  <Marquesina nombres={site.clientes} />

  {/* 3. Principios */}
  <section class="px-6 py-[clamp(72px,9vw,128px)]" aria-labelledby="t-principios">
    <div class="mx-auto flex max-w-[1240px] flex-col gap-14">
      <h2 id="t-principios" class="m-0 max-w-[900px] text-[clamp(36px,4.6vw,64px)] leading-[1.05] text-tinta">
        No compras horas. Compras documentos terminados.
      </h2>
      <div class="flex flex-wrap gap-10">
        {principios.map((p, i) => (
          <div class="flex min-w-0 flex-[1_1_300px] flex-col gap-3 border-t border-tinta pt-5">
            <span class="font-mono text-meta text-gris">{String(i + 1).padStart(2, '0')}</span>
            <strong class="text-[21px] font-semibold leading-snug">{p.titulo}</strong>
            <span class="text-base text-tenue">{p.texto}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* 4. Qué resolvemos */}
  <section class="bg-niebla px-6 py-[clamp(72px,9vw,120px)]" aria-labelledby="t-resolvemos" data-pestanas>
    <div class="mx-auto flex max-w-[1240px] flex-col gap-10">
      <EncabezadoSeccion etiqueta="Qué resolvemos" titulo="Elige un frente." />
      <span id="t-resolvemos" class="sr-only">Qué resolvemos</span>

      <div role="tablist" aria-label="Áreas de servicio" class="flex flex-wrap gap-x-7 gap-y-1 border-b border-linea-fuerte">
        {areas.map((a, i) => (
          <button
            type="button"
            role="tab"
            id={`pestana-${a.id}`}
            aria-controls={`panel-${a.id}`}
            aria-selected={i === 0 ? 'true' : 'false'}
            tabindex={i === 0 ? 0 : -1}
            class="-mb-px min-h-12 cursor-pointer border-0 border-b-2 border-transparent bg-transparent px-0.5 font-sans text-[17px] font-semibold text-gris transition-colors aria-selected:border-tinta aria-selected:text-tinta"
          >
            {a.pestana}
          </button>
        ))}
      </div>

      {areas.map((a, i) => (
        <div
          role="tabpanel"
          id={`panel-${a.id}`}
          aria-labelledby={`pestana-${a.id}`}
          hidden={i !== 0}
          class="flex flex-wrap gap-12"
        >
          <div class="flex min-w-0 flex-[1_1_460px] flex-col gap-5">
            <h3 class="m-0 font-display text-[clamp(30px,3vw,42px)] font-normal leading-[1.1]">{a.titulo}</h3>
            <p class="m-0 text-lead text-tenue">{a.texto}</p>
            <div class="flex flex-wrap gap-8 text-[15px]">
              <span class="flex flex-col gap-1">
                <span class="font-mono text-[12px] text-gris">Plazo</span>
                <strong class="font-semibold">{a.plazo}</strong>
              </span>
              <span class="flex flex-col gap-1">
                <span class="font-mono text-[12px] text-gris">Cómo se contrata</span>
                <strong class="font-semibold">{a.contratacion}</strong>
              </span>
            </div>
            <div class="flex flex-wrap items-center gap-x-6 gap-y-3">
              <BotonWhatsApp
                mensaje={`Hola, vengo de la web. Me interesa el servicio de ${a.titulo.toLowerCase()}.`}
                etiqueta="Consultar este servicio"
                variante="secundario"
                compacto
                class="self-start"
              />
              <a href={`/servicios#${a.servicio}`} class="text-[15px] font-semibold">Ver el servicio completo</a>
            </div>
          </div>
          <ul class="m-0 flex min-w-0 flex-[1_1_380px] list-none flex-col rounded-[18px] border border-linea bg-white p-0">
            {a.items.map((it) => (
              <li class="flex items-center justify-between gap-4 border-b border-linea px-6.5 py-5.5 text-[17px] last:border-b-0">
                {it}
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="shrink-0"><path d="M5 12l5 5L20 7" /></svg>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>

  {/* 5. Testimonios. Solo si hay reales en src/data/testimonios.json. */}
  <Testimonios />

  {/* 6. Planes, resumen */}
  <section class="sobre-tinta bg-tinta px-6 py-[clamp(72px,9vw,120px)] text-white" aria-labelledby="t-planes">
    <div class="mx-auto flex max-w-[1240px] flex-col gap-11">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <h2 id="t-planes" class="m-0 max-w-[700px] text-seccion text-white">Un plan mensual con topes claros.</h2>
        <Boton href="/planes" variante="acento" compacto>Comparar planes</Boton>
      </div>
      <div class="flex flex-col border-t border-linea-oscura">
        {planes.planes.map((p) => (
          <a
            href={`/planes#${p.id}`}
            class="flex flex-wrap items-baseline justify-between gap-x-8 gap-y-3 border-b border-linea-oscura py-7 text-white no-underline"
          >
            <span class="flex flex-[0_0_220px] flex-wrap items-center gap-3 font-display text-[32px]">
              {p.nombre}
              {p.destacado && (
                <span class="rounded-full bg-acento px-2.5 py-1 font-sans text-[11px] font-bold uppercase tracking-[0.08em] text-fijo-oscuro">
                  Recomendado
                </span>
              )}
            </span>
            <span class="flex-[1_1_360px] text-base text-claro">{p.resumen}</span>
            <span class="text-[22px] font-semibold tabular-nums">
              {p.desde && <span class="text-[14px] font-normal text-claro">desde </span>}
              {soles(p.precio)} <span class="text-[14px] font-normal text-claro">/ mes</span>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  {/* 7. Academy, resumen */}
  <section class="px-6 py-[clamp(72px,9vw,120px)]" aria-labelledby="t-academy">
    <div class="mx-auto flex max-w-[1240px] flex-wrap items-center gap-12">
      <div class="flex min-w-0 flex-[1_1_420px] flex-col gap-4.5">
        <EncabezadoSeccion etiqueta="Díada Academy" titulo="Derecho práctico para quienes dirigen empresas." />
        <span id="t-academy" class="sr-only">Academy</span>
        <p class="m-0 text-[17px] text-tenue">
          Charlas gratuitas, talleres, cursos a tu ritmo y capacitaciones para tu equipo.
        </p>
        <Boton href="/academy" variante="secundario" compacto class="self-start">Ver agenda completa</Boton>
      </div>

      {proximo ? (
        <a
          href={`/academy/${proximo.id}`}
          class="flex min-w-0 flex-[1_1_460px] items-start gap-7 rounded-tarjeta border border-linea bg-niebla p-8 text-tinta no-underline"
        >
          <span class="flex h-[92px] w-[84px] shrink-0 flex-col items-center justify-center rounded-[14px] bg-tinta text-white">
            <span class="font-display text-[40px] leading-none">{diaYMes(proximo.data.fecha).dia}</span>
            <span class="font-mono text-[12px] uppercase tracking-[0.12em]">{diaYMes(proximo.data.fecha).mes}</span>
          </span>
          <span class="flex flex-col gap-2.5">
            <span class="font-mono text-[12px] text-gris">
              Próximo {TIPOS[proximo.data.tipo].toLowerCase()} · {proximo.data.lugar} · {proximo.data.duracion}
            </span>
            <strong class="font-display text-[28px] font-medium leading-[1.15]">{proximo.data.titulo}</strong>
            <span class="text-[15px] font-semibold underline">
              {proximo.data.estado === 'abierto' ? 'Reservar cupo' : 'Ver detalle'}
            </span>
          </span>
        </a>
      ) : (
        <div class="flex min-w-0 flex-[1_1_460px] flex-col gap-4 rounded-tarjeta border border-linea bg-niebla p-8">
          <span class="font-mono text-[12px] text-gris">Agenda</span>
          <strong class="font-display text-[28px] font-medium leading-[1.15]">
            No hay fecha abierta en este momento.
          </strong>
          <p class="m-0 text-base text-tenue">
            Avísame por WhatsApp qué tema te interesa y lo agendo en la siguiente edición.
          </p>
          <BotonWhatsApp
            mensaje="Hola, vengo de la web. Me gustaría que Academy dicte un taller sobre este tema:"
            etiqueta="Proponer un tema"
            variante="secundario"
            compacto
            class="self-start"
          />
        </div>
      )}
    </div>
  </section>

  {/* 8. Nosotros */}
  <section id="nosotros" class="scroll-mt-20 border-t border-linea px-6 py-[clamp(72px,9vw,120px)]" aria-labelledby="t-nosotros">
    <div class="mx-auto flex max-w-[1240px] flex-wrap items-center gap-14">
      {site.mostrarRetrato && (
        <img
          src={site.rutaRetrato}
          width="360"
          height="450"
          loading="lazy"
          decoding="async"
          alt={`Retrato de ${site.abogado}, abogado del estudio`}
          class="aspect-[4/5] min-w-[240px] flex-[0_1_360px] rounded-[4px] object-cover"
        />
      )}
      <div class="flex min-w-0 flex-[1_1_480px] flex-col gap-5">
        <EncabezadoSeccion etiqueta="Quién está detrás" titulo={`${site.abogado}, abogado fundador.`} />
        <span id="t-nosotros" class="sr-only">Quién está detrás</span>
        <p class="m-0 max-w-[600px] text-lead leading-[1.7] text-tenue">
          Derecho Empresarial y Derecho Digital, con base en Huánuco y clientes en todo el país.
          Redacto contratos que la otra parte también entiende, porque un contrato que nadie
          entiende tampoco se cumple.
        </p>
        <div class="flex flex-wrap gap-6 text-[14px] text-tenue">
          <span>{site.colegiatura} · {site.colegio}</span>
          {linkedin && <a href={linkedin.url} target="_blank" rel="noopener noreferrer">LinkedIn</a>}
        </div>
      </div>
    </div>
  </section>

  {/* 9. Preguntas frecuentes */}
  <section class="bg-niebla px-6 py-[clamp(72px,9vw,120px)]" aria-labelledby="t-faq">
    <div class="mx-auto flex max-w-[860px] flex-col gap-8">
      <h2 id="t-faq" class="m-0 text-[clamp(34px,4vw,52px)] leading-[1.06] text-tinta">Preguntas frecuentes</h2>
      <Faq />
    </div>
  </section>

  {/* 10. Cierre */}
  <section id="contacto" class="scroll-mt-20 px-6 py-[clamp(80px,10vw,144px)] text-center">
    <div class="mx-auto flex max-w-[900px] flex-col items-center gap-6">
      <h2 class="m-0 text-cierre text-tinta tracking-[-0.025em]">Que un contrato no frene el negocio.</h2>
      <p class="m-0 text-lead text-tenue">
        Treinta minutos de diagnóstico, sin costo. Si no hay nada que hacer, te lo decimos.
      </p>
      <div class="flex flex-wrap justify-center gap-3">
        <Boton href="/diagnostico" class="px-7">Agendar diagnóstico</Boton>
        <BotonWhatsApp mensaje={MENSAJE_GENERAL} variante="secundario" icono class="px-7" />
      </div>
    </div>
  </section>
</Base>

<script>
  /* Pestañas «Qué resolvemos». Sin JavaScript se ve el primer panel. */
  const raiz = document.querySelector<HTMLElement>('[data-pestanas]');
  if (raiz) {
    const pestanas = Array.from(raiz.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
    const paneles = Array.from(raiz.querySelectorAll<HTMLElement>('[role="tabpanel"]'));
    const elegir = (i: number) => {
      pestanas.forEach((p, k) => {
        p.setAttribute('aria-selected', k === i ? 'true' : 'false');
        p.tabIndex = k === i ? 0 : -1;
      });
      paneles.forEach((p, k) => { p.hidden = k !== i; });
    };
    pestanas.forEach((p, i) => {
      p.addEventListener('click', () => elegir(i));
      p.addEventListener('keydown', (e) => {
        const paso = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
        if (!paso) return;
        const j = (i + paso + pestanas.length) % pestanas.length;
        elegir(j);
        pestanas[j].focus();
        e.preventDefault();
      });
    });
  }
</script>
