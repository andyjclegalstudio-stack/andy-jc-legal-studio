---
import faq from '../data/faq.json';
---
<div class="border-t border-linea">
  {faq.map((item) => (
    <details class="group border-b border-linea">
      <summary class="flex cursor-pointer list-none items-start justify-between gap-6 py-5 text-lead text-tinta marker:hidden [&::-webkit-details-marker]:hidden">
        <span>{item.pregunta}</span>
        <span
          aria-hidden="true"
          class="mt-2 shrink-0 text-jade transition-transform duration-150 group-open:rotate-45"
        >
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M7 1v12M1 7h12" />
          </svg>
        </span>
      </summary>
      <p class="medida mt-0 mb-5 text-base text-tenue">{item.respuesta}</p>
    </details>
  ))}
</div>
