---
import Base from '../layouts/Base.astro';
import BotonWhatsApp from '../components/BotonWhatsApp.astro';
import Faq from '../components/Faq.astro';
import site from '../data/site.json';
import faq from '../data/faq.json';

const atajos = [
  {
    titulo: 'Tengo un caso concreto',
    texto: 'Agenda la reunión de diagnóstico de 30 minutos. Sin costo y sin compromiso.',
    mensaje: 'Hola, vengo de la web. Quisiera coordinar la reunión de diagnóstico de 30 minutos.',
    etiqueta: 'Agendar diagnóstico',
  },
  {
    titulo: 'Necesito una revisión rápida de contrato',
    texto: 'Mándame el documento por WhatsApp y te digo qué encontré y cuánto costaría arreglarlo.',
    mensaje: 'Hola, vengo de la web. Necesito una revisión rápida de un contrato.',
    etiqueta: 'Enviar contrato',
  },
  {
    titulo: 'Me llegó una notificación',
    texto: 'De Indecopi, de la Autoridad de Protección de Datos o de la Sunafil. Los plazos corren, así que escribe hoy.',
    mensaje: 'Hola, vengo de la web. Me llegó una notificación y necesito orientación urgente.',
    etiqueta: 'Escribir ahora',
  },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({
    '@type': 'Question',
    name: f.pregunta,
    acceptedAnswer: { '@type': 'Answer', text: f.respuesta },
  })),
};
---

<Base
  titulo="Contacto — DIADA Legal Studio"
  descripcion="Escribe por WhatsApp al +51 922 163 731 o al correo del estudio. Reunión de diagnóstico de 30 minutos sin costo, con respuesta el mismo día hábil."
  jsonLd={jsonLd}
>
  <section class="contenedor pt-16 pb-14 md:pt-24">
    <p class="m-0 text-meta text-tenue">Contacto</p>
    <h1 class="mt-3 mb-0 max-w-[20ch] text-portada text-tinta">
      Todo empieza con un mensaje de WhatsApp
    </h1>
    <p class="medida mt-7 mb-0 text-lead text-tenue">
      No hay formulario que llenar ni cola de tickets. Escribe en dos líneas qué necesitas
      y te respondo el mismo día hábil. Si escribes fuera de horario, tienes respuesta a
      primera hora del día siguiente.
    </p>
    <BotonWhatsApp
      mensaje="Hola, vengo de la web. Quisiera coordinar la reunión de diagnóstico de 30 minutos."
      class="mt-10"
    />
  </section>

  <section class="border-t border-linea py-16" aria-labelledby="t-atajos">
    <div class="contenedor">
      <h2 id="t-atajos" class="m-0 text-seccion text-tinta">Según lo que necesites</h2>
      <div class="mt-10 grid gap-x-10 gap-y-10 md:grid-cols-3">
        {atajos.map((a) => (
          <div class="flex h-full flex-col border-t border-linea pt-6">
            <h3 class="m-0 text-card text-tinta">{a.titulo}</h3>
            <p class="mt-3 mb-0 text-base text-tenue">{a.texto}</p>
            <BotonWhatsApp
              mensaje={a.mensaje}
              etiqueta={a.etiqueta}
              variante="secundario"
              class="mt-6 self-start px-5 py-2.5"
            />
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="border-t border-linea bg-niebla py-16" aria-labelledby="t-datos">
    <div class="contenedor">
      <h2 id="t-datos" class="m-0 text-seccion text-tinta">Datos del estudio</h2>
      <dl class="m-0 mt-10 grid gap-x-10 gap-y-0 border-t border-linea md:grid-cols-2">
        <div class="border-b border-linea py-5">
          <dt class="m-0 text-meta text-tenue">WhatsApp</dt>
          <dd class="m-0 mt-1.5 text-lead">
            <a
              href={`https://wa.me/${site.whatsapp}`}
              target="_blank"
              rel="noopener noreferrer"
              class="text-jade underline decoration-jade/35 underline-offset-4 hover:decoration-jade"
            >
              {site.whatsappVisible}
            </a>
          </dd>
        </div>
        <div class="border-b border-linea py-5">
          <dt class="m-0 text-meta text-tenue">Correo</dt>
          <dd class="m-0 mt-1.5 text-lead">
            <a
              href={`mailto:${site.correo}`}
              class="break-all text-jade underline decoration-jade/35 underline-offset-4 hover:decoration-jade"
            >
              {site.correo}
            </a>
          </dd>
        </div>
        <div class="border-b border-linea py-5">
          <dt class="m-0 text-meta text-tenue">Colegiatura</dt>
          <dd class="m-0 mt-1.5 text-lead text-tinta">
            {site.colegiatura} — {site.colegio}
          </dd>
        </div>
        <div class="border-b border-linea py-5">
          <dt class="m-0 text-meta text-tenue">Cobertura</dt>
          <dd class="m-0 mt-1.5 text-lead text-tinta">
            {site.ciudad}, con atención remota a todo el país
          </dd>
        </div>
        <div class="border-b border-linea py-5">
          <dt class="m-0 text-meta text-tenue">Horario de atención</dt>
          <dd class="m-0 mt-1.5 text-lead text-tinta">Lunes a viernes, 9:00 a 19:00 h</dd>
        </div>
        <div class="border-b border-linea py-5">
          <dt class="m-0 text-meta text-tenue">Idioma</dt>
          <dd class="m-0 mt-1.5 text-lead text-tinta">Español</dd>
        </div>
      </dl>
    </div>
  </section>

  <section class="border-t border-linea py-16 md:py-20" aria-labelledby="t-faq-contacto">
    <div class="contenedor">
      <h2 id="t-faq-contacto" class="m-0 text-seccion text-tinta">Preguntas frecuentes</h2>
      <div class="mt-10 max-w-[52rem]">
        <Faq />
      </div>
    </div>
  </section>
</Base>
