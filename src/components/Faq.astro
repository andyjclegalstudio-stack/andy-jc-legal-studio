---
import faqGeneral from '../data/faq.json';

interface Pregunta { pregunta: string; respuesta: string }
interface Props {
  items?: Pregunta[];
  primeroAbierto?: boolean;
}
const { items = faqGeneral, primeroAbierto = true } = Astro.props;
---
<div class="flex flex-col border-t border-linea-fuerte">
  {items.map((item, i) => (
    <details class="group border-b border-linea-fuerte py-5.5" open={primeroAbierto && i === 0}>
      <summary class="flex items-start justify-between gap-4 text-[19px] font-semibold leading-snug text-tinta">
        <span>{item.pregunta}</span>
        <span aria-hidden="true" class="font-mono text-lead text-tinta">
          <span class="group-open:hidden">+</span><span class="hidden group-open:inline">−</span>
        </span>
      </summary>
      <p class="mb-0 mt-3.5 max-w-[66ch] text-base leading-[1.7] text-tenue">{item.respuesta}</p>
    </details>
  ))}
</div>
