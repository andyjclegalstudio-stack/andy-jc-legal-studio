---
import Marca from './Marca.astro';
import CambioTema from './CambioTema.astro';
import { clasesBoton } from '../lib/botones';
import site from '../data/site.json';

const rutaActual = Astro.url.pathname.replace(/\/$/, '') || '/';

const principales = [
  { href: '/', texto: 'Inicio' },
  { href: '/planes', texto: 'Planes' },
  { href: '/academy', texto: 'Academy' },
  { href: '/#nosotros', texto: 'Nosotros' },
];
/* Solo en el menú del celular: las páginas que la barra de escritorio no muestra. */
const secundarias = [
  { href: '/servicios', texto: 'Servicios' },
  { href: '/referidos', texto: 'Referidos' },
  { href: '/contacto', texto: 'Contacto' },
];

const activo = (href: string) =>
  href === '/' ? rutaActual === '/' : !href.includes('#') && (rutaActual === href || rutaActual.startsWith(href + '/'));
---
<header class="sticky top-0 z-30 border-b border-linea bg-white/95 backdrop-blur-sm">
  <nav aria-label="Principal" class="contenedor relative flex items-center justify-between gap-6 py-3">
    <a href="/" class="flex min-h-[44px] items-center no-underline" aria-label={`${site.nombre}, inicio`}>
      <Marca tamano="cabecera" />
    </a>

    <ul class="m-0 hidden list-none items-center gap-8 p-0 text-[15px] min-[860px]:flex">
      {principales.map((e) => (
        <li>
          <a
            href={e.href}
            aria-current={activo(e.href) ? 'page' : undefined}
            class:list={[
              'no-underline transition-colors hover:text-tinta-oscura',
              activo(e.href) ? 'border-b-[1.5px] border-tinta pb-[3px] font-semibold' : '',
            ]}
          >
            {e.texto}
          </a>
        </li>
      ))}
    </ul>

    <div class="flex items-center gap-3">
      <CambioTema />
      <div class="hidden min-[860px]:block">
        <a href="/diagnostico" class={clasesBoton('primario', true)}>Agendar diagnóstico</a>
      </div>

      {/* Menú del celular. <details> abre y cierra sin JavaScript. */}
      <details class="group min-[860px]:hidden">
        <summary
          class="flex h-11 w-11 items-center justify-center rounded-[12px] border border-borde bg-white"
          aria-label="Abrir menú"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" class="group-open:hidden">
            <path d="M4 7h16M4 12h16M4 17h10" />
          </svg>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" class="hidden group-open:block">
            <path d="M6 6l12 12M18 6L6 18" />
          </svg>
        </summary>
        <div class="absolute inset-x-0 top-full border-b border-linea bg-white px-6 pb-6 pt-2 shadow-[0_12px_32px_rgba(22,40,58,0.08)]">
          <ul class="m-0 list-none divide-y divide-linea p-0 text-lead">
            {principales.map((e) => (
              <li>
                <a href={e.href} class:list={['block py-3.5 no-underline', activo(e.href) ? 'font-semibold' : '']}>
                  {e.texto}
                </a>
              </li>
            ))}
            {secundarias.map((e) => (
              <li>
                <a href={e.href} class:list={['block py-3.5 text-base text-tenue no-underline', activo(e.href) ? 'font-semibold text-tinta' : '']}>
                  {e.texto}
                </a>
              </li>
            ))}
          </ul>
          <a href="/diagnostico" class:list={[clasesBoton('primario'), 'mt-5 w-full']}>
            Agendar diagnóstico gratuito
          </a>
        </div>
      </details>
    </div>
  </nav>
</header>
