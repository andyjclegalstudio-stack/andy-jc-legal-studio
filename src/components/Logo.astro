---
import { D_PARTES, D_CURVA, VIEWBOX_LOGO } from '../lib/monograma';
interface Props { class?: string; titulo?: string }
const { class: clase = 'h-9 w-auto', titulo = 'DIADA Legal Studio' } = Astro.props;
---
<svg
  class={clase}
  viewBox={VIEWBOX_LOGO}
  role="img"
  aria-label={titulo}
  xmlns="http://www.w3.org/2000/svg"
>
  <path d={D_CURVA} fill="var(--color-jade)" />
  <g fill="var(--color-tinta)">
    {D_PARTES.map((d) => <path d={d} />)}
  </g>
</svg>
