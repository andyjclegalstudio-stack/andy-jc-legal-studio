---
import { wa } from '../lib/whatsapp';
import { clasesBoton, type Variante } from '../lib/botones';

interface Props {
  mensaje: string;
  variante?: Variante;
  compacto?: boolean;
  icono?: boolean;
  class?: string;
  etiqueta?: string;
}
const {
  mensaje,
  variante = 'primario',
  compacto = false,
  icono = false,
  class: clase = '',
  etiqueta = 'Escribir por WhatsApp',
} = Astro.props;
---
<a
  href={wa(mensaje)}
  target="_blank"
  rel="noopener noreferrer"
  class={`${clasesBoton(variante, compacto)} ${clase}`}
>
  {icono && (
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="shrink-0">
      <path d="M21 12a9 9 0 0 1-13.5 7.8L3 21l1.2-4.4A9 9 0 1 1 21 12z" />
    </svg>
  )}
  {etiqueta}
</a>
