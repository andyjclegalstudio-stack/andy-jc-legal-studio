---
import site from '../data/site.json';
import Logo from './Logo.astro';
import { wa, MENSAJE_GENERAL } from '../lib/whatsapp';
const anio = new Date().getFullYear();
---
<footer class="sobre-tinta bg-tinta text-white/80">
  <div class="contenedor py-16 md:py-20">
    <div class="grid gap-10 md:grid-cols-[1.2fr_1fr_1fr]">
      <div>
        <div class="flex items-center gap-3">
          <Logo class="h-11 w-auto shrink-0 [&_path]:fill-white" />
          <span class="font-display text-lead leading-tight text-white">
            Andy J.C.<br />Legal Studio
          </span>
        </div>
        <p class="medida mt-5 text-base">
          Derecho Empresarial y Derecho Digital. {site.ciudad}, con atención remota a
          todo el país.
        </p>
        <p class="mt-4 text-meta text-white/60">
          {site.colegiatura} — {site.colegio}
        </p>
      </div>

      <div>
        <h2 class="m-0 font-sans text-meta font-semibold tracking-wide text-white">Contacto</h2>
        <ul class="m-0 mt-4 list-none space-y-2.5 p-0 text-base">
          <li>
            <a href={wa(MENSAJE_GENERAL)} target="_blank" rel="noopener noreferrer" class="text-white/85 underline decoration-white/30 underline-offset-4 hover:text-ambar">
              WhatsApp {site.whatsappVisible}
            </a>
          </li>
          <li>
            <a href={`mailto:${site.correo}`} class="text-white/85 underline decoration-white/30 underline-offset-4 hover:text-ambar break-all">
              {site.correo}
            </a>
          </li>
          {site.redes.map((r: { nombre: string; url: string }) => (
            <li>
              <a href={r.url} target="_blank" rel="noopener noreferrer" class="text-white/85 underline decoration-white/30 underline-offset-4 hover:text-ambar">
                {r.nombre}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h2 class="m-0 font-sans text-meta font-semibold tracking-wide text-white">Secciones</h2>
        <ul class="m-0 mt-4 list-none space-y-2.5 p-0 text-base">
          <li><a href="/servicios" class="text-white/85 no-underline hover:text-ambar">Servicios</a></li>
          <li><a href="/academy" class="text-white/85 no-underline hover:text-ambar">Academy</a></li>
          <li><a href="/referidos" class="text-white/85 no-underline hover:text-ambar">Programa de referidos</a></li>
          <li><a href="/contacto" class="text-white/85 no-underline hover:text-ambar">Contacto</a></li>
          <li><a href="/aviso-legal" class="text-white/85 no-underline hover:text-ambar">Aviso legal</a></li>
        </ul>
      </div>
    </div>

    <div class="mt-14 border-t border-white/15 pt-6">
      <p class="medida m-0 text-meta text-white/55">
        El contenido de este sitio es informativo y de divulgación. No constituye asesoría
        jurídica ni crea una relación abogado-cliente. Cada caso exige un análisis propio.
      </p>
      <p class="m-0 mt-3 text-meta text-white/55">
        © {anio} {site.nombre}. Todos los derechos reservados.
      </p>
    </div>
  </div>
</footer>
